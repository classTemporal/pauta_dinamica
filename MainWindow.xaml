<Window x:Class="PautaDinamicaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PautaDinamicaApp"
        xmlns:vm="clr-namespace:PautaDinamicaApp.ViewModels"
        xmlns:views="clr-namespace:PautaDinamicaApp.Views"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        mc:Ignorable="d"
        x:Name="MainWin"
        Title="Pauta Dinámica - Auditoría" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <views:FieldTemplateSelector x:Key="FieldTemplateSelector"
                TextTemplate="{StaticResource TextTemplate}"
                NumericTemplate="{StaticResource NumericTemplate}"
                BooleanTemplate="{StaticResource BooleanTemplate}"
                DropdownTemplate="{StaticResource DropdownTemplate}"
                DateTemplate="{StaticResource DateTemplate}"
                TimeTemplate="{StaticResource TimeTemplate}"
                SeparatorTemplate="{StaticResource SeparatorTemplate}"
                CalculationTemplate="{StaticResource CalculationTemplate}"
                AverageTemplate="{StaticResource AverageTemplate}"
                TextAreaTemplate="{StaticResource TextAreaTemplate}"/>

            <!-- Group Style -->
            <Style x:Key="GroupHeaderStyle" TargetType="{x:Type GroupItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupItem}">
                            <Border Background="{StaticResource CardBackgroundBrush}" 
                                    CornerRadius="8" Margin="0,0,0,15" Padding="15"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource AccentBrush}" 
                                               FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ItemsPresenter />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,15" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sistema de Registro de Llamadas" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,30,0"/>
                    
                    <!-- Pauta Selector -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Pauta actual:" Foreground="#888" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding Pautas}" 
                                  SelectedItem="{Binding CurrentPauta}"
                                  DisplayMemberPath="Name"
                                  Width="200" Height="32"
                                  Background="#2d3446" Foreground="White" BorderBrush="#3d4456">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#2d3446"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>

                        <!-- Botón de Ayuda -->
                        <Button Command="{Binding ShowHelpCommand}"
                                Style="{StaticResource GhostButton}"
                                Width="32" Height="32" Padding="0" Margin="10,0,0,0"
                                ToolTip="Ver instrucciones de esta pauta">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="?" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⚙️ CONFIG. GENERAL" Command="{Binding OpenSettingsCommand}" 
                            Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,10,0"/>
                    <Button Content="✏️ CONFIG. PAUTA" Command="{Binding OpenConfigCommand}" 
                            Style="{StaticResource GhostButton}" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Dynamic Form with grouping -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
                    <Button Command="{Binding SaveRecordCommand}" 
                            Height="40" Padding="20,0" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                <Setter Property="Content" Value="➕ Agregar Registro"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Content" Value="💾 Actualizar Registro"/>
                                        <Setter Property="Background" Value="#ffc107"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SendEmailsCommand}" 
                            Content="📧 Enviar todos los correos" Height="40" Padding="20,0" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding GroupedFields}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}"/>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Width" Value="250"/>
                                <Setter Property="Margin" Value="10,5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Separator">
                                        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource AncestorType=ItemsPresenter}, Path=ActualWidth}"/>
                                        <Setter Property="Margin" Value="10,15,10,5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource FieldTemplateSelector}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Right: Records Grid -->
            <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Registros de Llamadas" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                            <Button Content="☑️ Selección Múltiple" Command="{Binding ToggleMultiSelectCommand}" Padding="10,8" Style="{StaticResource SecondaryButton}" Margin="0,5,10,5"/>
                            <Button Content="📥 Importar Excel" Command="{Binding ImportFromExcelCommand}" Padding="10,8" Style="{StaticResource SecondaryButton}" Margin="0,5,10,5" Background="#6f42c1"/>
                            <Button Content="📊 Exportar a Excel" Command="{Binding ExportToExcelCommand}" Padding="10,8" Style="{StaticResource ExcelButton}" Margin="0,5,0,5"/>
                        </WrapPanel>

                        <!-- MultiSelect Actions -->
                        <Border Background="#3d4456" CornerRadius="4" Padding="5" Margin="0,5,0,0"
                                Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="MODO SELECCIÓN" VerticalAlignment="Center" FontWeight="Bold" Foreground="#ffc107" Margin="10,5,20,5"/>
                                <Button Content="✔️ Seleccionar Todo" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,5,10,5"/>
                                <Button Content="📧 Enviar Multiples" Command="{Binding SendEmailsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,5,10,5"/>
                                <Button Content="📄 Generar PDF" Command="{Binding GenerateSelectedPdfCommand}" Style="{StaticResource SecondaryButton}" Background="#DC3545" Margin="0,5,10,5"/>
                                <Button Content="🗑️ Borrar Seleccionados" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Margin="0,5,10,5"/>
                                <Button Content="📊 Exportar Seleccionados" Command="{Binding ExportSelectedCommand}" Style="{StaticResource ExcelButton}" Margin="0,5,10,5"/>
                                <Button Content="❌ Cancelar" Command="{Binding ToggleMultiSelectCommand}" Style="{StaticResource GhostButton}" Margin="10,5,0,5" Padding="12,8"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                    
                    <DataGrid x:Name="RecordsGrid" ItemsSource="{Binding Records}" 
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               Background="Transparent"
                               Foreground="{StaticResource TextBrush}"
                               BorderThickness="0"
                               GridLinesVisibility="None"
                               HeadersVisibility="Column"
                               CanUserAddRows="False"
                               HorizontalScrollBarVisibility="Visible"
                               SelectionUnit="FullRow"
                               SelectionMode="Extended"
                               AlternationCount="2"
                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        
                        <DataGrid.Resources>
                            <conv:BindingProxy x:Key="Proxy" Data="{Binding}"/>
                        </DataGrid.Resources>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="Background" Value="#1e222d"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="📧 Enviar Correo" 
                                                      Command="{Binding PlacementTarget.Tag.SendEmailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📧"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="📝 Editar Registro" 
                                                      Command="{Binding PlacementTarget.Tag.SelectRecordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📝"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="📄 Generar PDF" 
                                                      Command="{Binding PlacementTarget.Tag.GeneratePdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📄"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="🗑️ Eliminar Registro" 
                                                      Command="{Binding PlacementTarget.Tag.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🗑️"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#262b38"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="#3d4456"/>
                                    </DataTrigger>
                                    <!-- Custom Row Color Trigger -->
                                    <DataTrigger Binding="{Binding RowColor, Converter={StaticResource NotNullToBooleanConverter}}" Value="True">
                                        <Setter Property="Background" Value="{Binding RowColor, Converter={StaticResource StringToBrushConverter}}"/>
                                    </DataTrigger>
                                    <!-- Hover effect to maintain readability -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#007bff"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Checkbox for MultiSelect -->
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="✔"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.Visibility>
                                    <Binding Path="Data.IsMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                                </DataGridTemplateColumn.Visibility>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Acciones" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📧" Command="{Binding Tag.SendEmailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}" Width="30" Height="25" Margin="2" Padding="0"
                                                    ToolTip="Enviar este correo"/>
                                            <Button Content="📄" Command="{Binding Tag.GeneratePdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}" Background="#DC3545" Width="30" Height="25" Margin="2" Padding="0"
                                                    ToolTip="Generar PDF"/>
                                            <Button Content="📝" Command="{Binding Tag.SelectRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ModernButtonBase}" Background="#ffc107" Foreground="Black" Width="30" Height="25" Margin="2" Padding="0">
                                                <Button.ToolTip>Cargar en formulario para editar</Button.ToolTip>
                                            </Button>
                                            <Button Content="🗑️" Command="{Binding Tag.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}" Width="30" Height="25" Margin="2" Padding="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.Visibility>
                                    <Binding Path="Data.IsMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}" ConverterParameter="Inverse"/>
                                </DataGridTemplateColumn.Visibility>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer / Barra Inferior -->
        <Border Grid.Row="2" Padding="20,5" Background="#1a1d26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ShowGeneralHelpCommand}" 
                            Style="{StaticResource GhostButton}" 
                            Padding="10,2" Margin="0" Height="25">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📘 Documentación y Guía del Sistema" FontSize="11" VerticalAlignment="Center" Foreground="#3b82f6"/>
                        </StackPanel>
                    </Button>
                    <Separator Width="1" Height="15" Margin="10,0" Background="#3d4456"/>
                    <TextBlock Text="v1.1.0" FontSize="10" Foreground="#64748b" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="👤 Usuario: " FontSize="10" Foreground="#64748b" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentUser.Username}" FontSize="10" FontWeight="Bold" Foreground="#e1e1e1" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    
                    <Button Command="{Binding LogoutCommand}" 
                            Style="{StaticResource GhostButton}" Foreground="#dc3545"
                            Padding="10,2" Margin="0" Height="25" Content="CERRAR SESIÓN"/>

                    <TextBlock Text="Pauta Dinámica - Auditoría de Calidad" 
                               Margin="20,0,0,0"
                               VerticalAlignment="Center" 
                               FontSize="10" Foreground="#4a5568" FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
