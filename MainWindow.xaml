<Window x:Class="PautaDinamicaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PautaDinamicaApp"
        xmlns:vm="clr-namespace:PautaDinamicaApp.ViewModels"
        xmlns:views="clr-namespace:PautaDinamicaApp.Views"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        mc:Ignorable="d"
        x:Name="MainWin"
        Title="CHECK-O - Pauta Dinámica" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/logo.ico">

    <Window.Resources>
        <ResourceDictionary>
            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:GridLengthConverter x:Key="GridLengthConverter"/>
            <conv:StringSwitchConverter x:Key="StringSwitchConverter"/>

            <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <views:FieldTemplateSelector x:Key="FieldTemplateSelector"
                TextTemplate="{StaticResource TextTemplate}"
                NumericTemplate="{StaticResource NumericTemplate}"
                BooleanTemplate="{StaticResource BooleanTemplate}"
                DropdownTemplate="{StaticResource DropdownTemplate}"
                DateTemplate="{StaticResource DateTemplate}"
                TimeTemplate="{StaticResource TimeTemplate}"
                SeparatorTemplate="{StaticResource SeparatorTemplate}"
                CalculationTemplate="{StaticResource CalculationTemplate}"
                AverageTemplate="{StaticResource AverageTemplate}"
                TextAreaTemplate="{StaticResource TextAreaTemplate}"
                FileAttachmentTemplate="{StaticResource FileAttachmentTemplate}"/>


            <!-- Group Style -->
            <Style x:Key="GroupHeaderStyle" TargetType="{x:Type GroupItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupItem}">
                            <Border Background="{DynamicResource CardBackgroundBrush}" 
                                    CornerRadius="8" Margin="0,0,0,15" Padding="15"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentBrush}" 
                                               FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ItemsPresenter />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,15" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsHeaderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <TextBlock Grid.Column="0" Text="CHECK-O" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                
                <!-- Center: Pauta Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Pauta actual:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="10,0,10,0" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding Pautas}" 
                              SelectedItem="{Binding CurrentPauta}"
                              DisplayMemberPath="Name"
                              Width="200" Height="32">
                    </ComboBox>

                    <!-- Botón de Ayuda -->
                    <Button Command="{Binding ShowHelpCommand}"
                            Style="{StaticResource GhostButton}"
                            Width="32" Height="32" Padding="0" Margin="10,0,0,0"
                            ToolTip="Ver instrucciones de esta pauta">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="?" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                
                <!-- Right: Utility Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                        <TextBlock Text="🔄 POSICIÓN DE REGISTRO:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding DashboardLayoutOptions}" 
                                  SelectedItem="{Binding DashboardLayoutString}"
                                  Width="100" Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Theme Toggle -->
                    <Button Command="{Binding ToggleThemeCommand}" 
                            Style="{StaticResource GhostButton}" Width="40" Height="32" Padding="0" Margin="0,0,15,0" ToolTip="Cambiar Tema">
                        <Path Data="{DynamicResource ThemeToggleIcon}" 
                               Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <Button Content="⚙️ CONFIG. GENERAL" Command="{Binding OpenSettingsCommand}" 
                            Style="{StaticResource GhostButton}" Padding="10,0" Height="32" Margin="0,0,10,0"/>
                    <Button Content="👁️" Command="{Binding ToggleHeaderCommand}"
                            Style="{StaticResource GhostButton}" Width="32" Height="32" Padding="0" Margin="0,0,10,0"
                            ToolTip="Ocultar/Mostrar encabezado"/>
                    <Button Content="✏️ CONFIG. PAUTA" Command="{Binding OpenConfigCommand}" 
                            Style="{StaticResource GhostButton}" Padding="10,0" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="Row0">
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DashboardLayout}" Value="Bottom">
                                    <Setter Property="Height" Value="{Binding DashboardFormHeight, Mode=TwoWay, Converter={StaticResource GridLengthConverter}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
                <RowDefinition x:Name="RowSplit" Height="Auto"/>
                <RowDefinition x:Name="Row2">
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DashboardLayout}" Value="Top">
                                    <Setter Property="Height" Value="{Binding DashboardFormHeight, Mode=TwoWay, Converter={StaticResource GridLengthConverter}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Col0">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DashboardLayout}" Value="Right">
                                    <Setter Property="Width" Value="{Binding DashboardFormWidth, Mode=TwoWay, Converter={StaticResource GridLengthConverter}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition x:Name="ColSplit" Width="Auto"/>
                <ColumnDefinition x:Name="Col2">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DashboardLayout}" Value="Left">
                                    <Setter Property="Width" Value="{Binding DashboardFormWidth, Mode=TwoWay, Converter={StaticResource GridLengthConverter}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!-- Vertical GridSplitter (For Left/Right) -->
            <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                          Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Left">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Right">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- Horizontal GridSplitter (For Top/Bottom) -->
            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                          Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Top">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Bottom">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- Dynamic Form (General) -->
            <DockPanel Margin="0">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Left">
                                <Setter Property="Grid.Column" Value="2"/>
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.RowSpan" Value="3"/>
                                <Setter Property="Margin" Value="10,0,0,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Right">
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.RowSpan" Value="3"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Top">
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.Row" Value="2"/>
                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                                <Setter Property="Margin" Value="0,10,0,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Bottom">
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
                    <Button Command="{Binding SaveRecordCommand}" 
                            Height="40" Padding="20,0" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                <Setter Property="Content" Value="➕ Agregar Registro"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Content" Value="💾 Actualizar Registro"/>
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding CancelEditCommand}" 
                            Content="✖️ Cancelar" Height="40" Padding="20,0" Margin="0,0,10,0"
                            Style="{StaticResource DangerButton}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding GroupedFields}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}"/>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Width" Value="250"/>
                                <Setter Property="Margin" Value="10,5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Separator">
                                        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource AncestorType=ItemsPresenter}, Path=ActualWidth}"/>
                                        <Setter Property="Margin" Value="10,15,10,5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="TextArea">
                                        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource AncestorType=ItemsPresenter}, Path=ActualWidth}"/>
                                        <Setter Property="Margin" Value="0,5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource FieldTemplateSelector}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Right: Records Grid -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Left">
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.RowSpan" Value="3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Right">
                                <Setter Property="Grid.Column" Value="2"/>
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.RowSpan" Value="3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Top">
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DashboardLayout}" Value="Bottom">
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.Row" Value="2"/>
                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Registros de Auditorías" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,5"/>
                            <TextBlock Text="{Binding AuditStatsText}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        </WrapPanel>

                        <Button Grid.Column="1" Command="{Binding ToggleFiltersCommand}" 
                                Style="{StaticResource GhostButton}" Padding="10,0" Height="28" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding IsFiltersPanelExpanded, ConverterParameter='Ocultar Filtros|Mostrar Filtros', Converter={StaticResource StringSwitchConverter}}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Filter and Sort Bar -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BackgroundBrush}" 
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,15"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding IsFiltersPanelExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- Search -->
                                <StackPanel Margin="0,0,10,5">
                                    <TextBlock Text="BUSCAR EN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding FilterFieldOptions}" 
                                              SelectedValue="{Binding SearchFieldId}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Width="130" Height="28"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,15,5" VerticalAlignment="Bottom">
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="28" 
                                             VerticalContentAlignment="Center" Padding="5,0"/>
                                </StackPanel>

                                <!-- Date Range Filter -->
                                <StackPanel Margin="0,0,15,5" Visibility="{Binding IsDateFilterVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="RANGO DE FECHAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding PickDateFromCommand}" Style="{StaticResource FilterButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📅" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FilterStartDate, StringFormat='dd/MM/yyyy', TargetNullValue='Desde'}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                                        <Button Command="{Binding PickDateToCommand}" Style="{StaticResource FilterButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📅" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FilterEndDate, StringFormat='dd/MM/yyyy', TargetNullValue='Hasta'}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Time Range Filter -->
                                <StackPanel Margin="0,0,15,5" Visibility="{Binding IsTimeFilterVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="RANGO DE HORAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding PickTimeFromCommand}" Style="{StaticResource FilterButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🕒" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FilterStartDate, StringFormat='HH:mm', TargetNullValue='Desde'}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                                        <Button Command="{Binding PickTimeToCommand}" Style="{StaticResource FilterButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🕒" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FilterEndDate, StringFormat='HH:mm', TargetNullValue='Hasta'}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Sorting -->
                                <StackPanel Margin="0,0,10,5">
                                    <TextBlock Text="ORDENAR POR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding SortFieldOptions}" 
                                              SelectedValue="{Binding SortFieldId}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Width="140" Height="28"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,15,5">
                                    <TextBlock Text="ORDEN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding SortDirectionOptions}"
                                              SelectedValue="{Binding SortDirection}"
                                              Width="110" Height="28"/>
                                </StackPanel>
                            </WrapPanel>

                            <Button Grid.Column="1" Command="{Binding ClearFiltersCommand}" 
                                    Content="🧹 Limpiar Filtros" Style="{StaticResource GhostButton}" 
                                    Height="28" VerticalAlignment="Bottom" Margin="0,0,0,5" Padding="10,0"/>
                        </Grid>
                    </Border>
                    
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                            <Button Content="☑️ Selección Múltiple" Command="{Binding ToggleMultiSelectCommand}" Padding="10,8" Style="{StaticResource SecondaryButton}" Margin="0,5,10,5"/>
                            <Button Content="📧 Enviar todos los correos" Command="{Binding SendEmailsCommand}" Padding="10,8" Style="{StaticResource SecondaryButton}" Margin="0,5,10,5"/>
                            <Button Content="📥 Importar Excel" Command="{Binding ImportFromExcelCommand}" Padding="10,8" Style="{StaticResource SecondaryButton}" Margin="0,5,10,5" Background="#6f42c1"/>
                            <Button Content="📊 Exportar a Excel" Command="{Binding ExportToExcelCommand}" Padding="10,8" Style="{StaticResource ExcelButton}" Margin="0,5,0,5"/>
                        </WrapPanel>

                        <!-- MultiSelect Actions -->
                        <Border Background="{DynamicResource BorderBrush}" CornerRadius="4" Padding="5" Margin="0,5,0,0"
                                Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="MODO SELECCIÓN" VerticalAlignment="Center" FontWeight="Bold" Foreground="#ffc107" Margin="10,5,20,5"/>
                                <Button Content="✔️ Seleccionar Todo" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,5,10,5"/>
                                <Button Content="📧 Enviar Multiples" Command="{Binding SendEmailsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,5,10,5"/>
                                <Button Content="📄 Generar PDF" Command="{Binding GenerateSelectedPdfCommand}" Style="{StaticResource SecondaryButton}" Background="#DC3545" Margin="0,5,10,5"/>
                                 <Button Content="📊 Exportar Seleccionados" Command="{Binding ExportSelectedCommand}" Style="{StaticResource ExcelButton}" Margin="0,5,10,5"/>
                                <Button Content="🗑️ Borrar Seleccionados" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Margin="0,5,10,5"/>
                                <Button Content="❌ Cancelar" Command="{Binding ToggleMultiSelectCommand}" Style="{StaticResource GhostButton}" Margin="10,5,0,5" Padding="12,8"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                    
                    <DataGrid x:Name="RecordsGrid" ItemsSource="{Binding RecordsView}" 
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               Background="Transparent"
                               Foreground="{DynamicResource TextBrush}"
                               BorderThickness="0"
                               GridLinesVisibility="None"
                               HeadersVisibility="Column"
                               CanUserAddRows="False"
                               HorizontalScrollBarVisibility="Visible"
                               SelectionUnit="FullRow"
                               SelectionMode="Extended"
                               AlternationCount="2"
                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        
                        <DataGrid.Resources>
                            <conv:BindingProxy x:Key="Proxy" Data="{Binding}"/>
                        </DataGrid.Resources>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="📧 Enviar Correo" 
                                                      Command="{Binding PlacementTarget.Tag.SendEmailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📧"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="📝 Editar Registro" 
                                                      Command="{Binding PlacementTarget.Tag.SelectRecordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📝"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="📄 Generar PDF" 
                                                      Command="{Binding PlacementTarget.Tag.GeneratePdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📄"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="🗑️ Eliminar Registro" 
                                                      Command="{Binding PlacementTarget.Tag.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🗑️"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                    </DataTrigger>
                                    <!-- Custom Row Color Trigger -->
                                    <DataTrigger Binding="{Binding RowColor, Converter={StaticResource NotNullToBooleanConverter}}" Value="True">
                                        <Setter Property="Background" Value="{Binding RowColor, Converter={StaticResource StringToBrushConverter}}"/>
                                    </DataTrigger>
                                    <!-- Missing Attachments Trigger -->
                                    <DataTrigger Binding="{Binding HasMissingAttachments}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <!-- Hover effect to maintain readability -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Checkbox for MultiSelect -->
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="✔"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.Visibility>
                                    <Binding Path="Data.IsMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                                </DataGridTemplateColumn.Visibility>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Acciones" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📧" Command="{Binding Tag.SendEmailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}" Width="30" Height="25" Margin="2" Padding="0"
                                                    ToolTip="Enviar este correo"/>
                                            <Button Content="📄" Command="{Binding Tag.GeneratePdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}" Background="#DC3545" Width="30" Height="25" Margin="2" Padding="0"
                                                    ToolTip="Generar PDF"/>
                                            <Button Content="📝" Command="{Binding Tag.SelectRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ModernButtonBase}" Background="#ffc107" Foreground="Black" Width="30" Height="25" Margin="2" Padding="0">
                                                <Button.ToolTip>Cargar en formulario para editar</Button.ToolTip>
                                            </Button>
                                            <Button Content="🗑️" Command="{Binding Tag.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}" Width="30" Height="25" Margin="2" Padding="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.Visibility>
                                    <Binding Path="Data.IsMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}" ConverterParameter="Inverse"/>
                                </DataGridTemplateColumn.Visibility>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer / Barra Inferior -->
        <Border Grid.Row="2" Padding="20,5" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ShowGeneralHelpCommand}" 
                            Style="{StaticResource GhostButton}" 
                            Padding="10,2" Margin="0" Height="25">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📘 Documentación y Guía del Sistema" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Button>
                    <Separator Width="1" Height="15" Margin="10,0" Background="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="v2.1.0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="👤 Usuario: " FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentUser.Username}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    
                    <Button Command="{Binding LogoutCommand}" 
                            Style="{StaticResource GhostButton}" Foreground="{DynamicResource DangerBrush}"
                            Padding="10,2" Margin="0" Height="25" Content="CERRAR SESIÓN"/>

                    <TextBlock Text="CHECK-O - Auditoría de Calidad" 
                               Margin="20,0,0,0"
                               VerticalAlignment="Center" 
                               FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
