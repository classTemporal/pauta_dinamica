<UserControl x:Class="PautaDinamicaApp.Views.HtmlEditor.HybridHtmlEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="FallbackNotice" Grid.Row="0" Margin="0,0,0,4" FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed"
                   Text="Modo compatibilidad: WebView2 no disponible en este equipo."/>
        <ContentControl x:Name="Host" Grid.Row="1"/>
    </Grid>
</UserControl>
