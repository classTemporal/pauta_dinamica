<UserControl x:Class="PautaDinamicaApp.Views.HtmlEditor.NativeRichEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CardBackgroundBrush}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,2,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0"
                CornerRadius="6,6,0,0" Padding="4">
            <WrapPanel>
                <Button x:Name="BoldBtn" Style="{StaticResource ToolButton}" Content="B" FontWeight="Bold" ToolTip="Negrita" Click="BoldBtn_Click"/>
                <Button x:Name="ItalicBtn" Style="{StaticResource ToolButton}" Content="I" FontStyle="Italic" ToolTip="Cursiva" Click="ItalicBtn_Click"/>
                <Button x:Name="UnderlineBtn" Style="{StaticResource ToolButton}" ToolTip="Subrayado" Click="UnderlineBtn_Click">
                    <TextBlock Text="U" TextDecorations="Underline" Foreground="{DynamicResource TextBrush}"/>
                </Button>
                <TextBlock Style="{StaticResource ToolLabel}" Text="|"/>
                <Button Style="{StaticResource ToolButton}" Content="A" Foreground="#dc3545" ToolTip="Rojo" Click="ColorBtn_Click" Tag="#dc3545"/>
                <Button Style="{StaticResource ToolButton}" Content="A" Foreground="#28a745" ToolTip="Verde" Click="ColorBtn_Click" Tag="#28a745"/>
                <Button Style="{StaticResource ToolButton}" Content="A" Foreground="#0078D4" ToolTip="Azul" Click="ColorBtn_Click" Tag="#0078D4"/>
                <Button Style="{StaticResource ToolButton}" Content="A" Foreground="{DynamicResource TextBrush}" ToolTip="Automático" Click="ColorBtn_Click" Tag="#000000"/>
                <TextBlock Style="{StaticResource ToolLabel}" Text="|"/>
                <Button Style="{StaticResource ToolButton}" Content="•" ToolTip="Viñetas" Click="BulletsBtn_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="1." ToolTip="Numerada" Click="NumbersBtn_Click"/>
                <TextBlock Style="{StaticResource ToolLabel}" Text="|"/>
                <Button Style="{StaticResource ToolButton}" Content="🔗" ToolTip="Insertar enlace" Click="LinkBtn_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="🖼" ToolTip="Insertar imagen" Click="ImageBtn_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="−" ToolTip="Reducir imagen seleccionada" Click="ImageShrinkBtn_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="+" ToolTip="Ampliar imagen seleccionada" Click="ImageGrowBtn_Click"/>
                <TextBlock Style="{StaticResource ToolLabel}" Text="|"/>
                <Button Style="{StaticResource ToolButton}" Content="✕" ToolTip="Quitar formato" Click="ClearBtn_Click"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,0" Padding="4">
            <WrapPanel>
                <TextBlock Style="{StaticResource ToolLabel}" Text="Tabla:"/>
                <Button Style="{StaticResource ToolButton}" Content="2×2" ToolTip="Insertar tabla de 2×2" Click="TableBtn_Click" Tag="2,2"/>
                <Button Style="{StaticResource ToolButton}" Content="3×2" ToolTip="Insertar tabla de 3×2" Click="TableBtn_Click" Tag="3,2"/>
                <Button Style="{StaticResource ToolButton}" Content="3×3" ToolTip="Insertar tabla de 3×3" Click="TableBtn_Click" Tag="3,3"/>
                <Button Style="{StaticResource ToolButton}" Content="4×3" ToolTip="Insertar tabla de 4×3" Click="TableBtn_Click" Tag="4,3"/>
                <TextBlock Style="{StaticResource ToolLabel}" Text="|"/>
                <TextBlock Style="{StaticResource ToolLabel}" Text="Imagen:"/>
                <ComboBox x:Name="ImageSizeBox" Width="110" Height="30" ToolTip="Tamaño al insertar imágenes"
                          SelectionChanged="ImageSizeBox_SelectionChanged">
                    <ComboBoxItem Content="Original" Tag="0" IsSelected="True"/>
                    <ComboBoxItem Content="Pequeña (200)" Tag="200"/>
                    <ComboBoxItem Content="Mediana (400)" Tag="400"/>
                    <ComboBoxItem Content="Grande (600)" Tag="600"/>
                </ComboBox>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
                CornerRadius="0,0,6,6" MinHeight="250">
            <Grid>
                <RichTextBox x:Name="EditorBox" MinHeight="250" Height="350"
                             VerticalScrollBarVisibility="Auto"
                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                             TextChanged="EditorBox_TextChanged" LostFocus="EditorBox_LostFocus"/>
                <Thumb Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Cursor="SizeNWSE" DragDelta="EditorThumb_DragDelta" Opacity="0.6">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Data="M11,0 L11,11 L0,11 Z" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" Margin="4,4,0,0" FontSize="10"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Editor nativo (sin WebView2). Arrastra la esquina para agrandar. [Etiqueta] y [Fecha] se resuelven al enviar."/>
    </Grid>
</UserControl>
