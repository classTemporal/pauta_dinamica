<Window x:Class="PautaDinamicaApp.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PautaDinamicaApp.ViewModels"
        xmlns:models="clr-namespace:PautaDinamicaApp.Models"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Diseñador de Pauta" Height="700" Width="1150"
        WindowStartupLocation="CenterOwner"
        MinWidth="900" MinHeight="600"
        Background="#12151c" Foreground="#e1e1e1">
    


    <Window.Resources>
        <ResourceDictionary>
            <conv:PrependOptionConverter x:Key="PrependOptionConverter"/>
            <conv:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter"/>
            <x:Array x:Key="BooleanOptions" Type="{x:Type sys:String}">
                <sys:String>True</sys:String>
                <sys:String>False</sys:String>
            </x:Array>
            <SolidColorBrush x:Key="SeparatorBackground" Color="#003566"/>
            <SolidColorBrush x:Key="CardBackground" Color="#1e222d"/>
            <SolidColorBrush x:Key="RowAlternatingBackground" Color="#262b38"/>
            <conv:BindingProxy x:Key="Proxy" Data="{Binding}"/>



            <!-- Prevenir que el DataGrid ponga fondos blancos al seleccionar -->
            <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#3d4456"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#e1e1e1"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowBackground" Value="#1e222d"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAlternatingBackground}"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#007bff"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="GridTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#2d3446"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#3d4456"/>
                <Setter Property="Padding" Value="5,2"/>
                <Setter Property="CaretBrush" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Margin" Value="0,1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Type}" Value="Separator">
                        <Setter Property="Background" Value="{StaticResource SeparatorBackground}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MoveButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
                <Setter Property="Background" Value="#2d3446"/>
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Side Management (Pautas) -->
        <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Gestión de Pautas" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                <!-- Actions for Pautas -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                    <Button Content="+ Nueva Pauta" Command="{Binding AddPautaCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" Height="40"/>
                    <Grid Margin="0,0,0,15">
                        <Button Content="☑️ Selección Múltiple" Command="{Binding TogglePautaMultiSelectCommand}" 
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                Visibility="{Binding IsPautaMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsPautaMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="✔️ Todo" Command="{Binding SelectAllPautasCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                            <Button Content="🗑️ Borrar" Command="{Binding DeleteSelectedPautasCommand}" Style="{StaticResource DangerButton}"/>
                            <Button Content="❌" Command="{Binding TogglePautaMultiSelectCommand}" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Base de Datos (Sistema) -->
                    <Border Background="#1a1d26" CornerRadius="8" Padding="12" BorderBrush="#2d3446" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="BASE DE DATOS (SISTEMA)" Foreground="#64748b" FontSize="9" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="📥 Importar" Command="{Binding ImportAllDatabaseCommand}" 
                                        Style="{StaticResource GhostButton}" Margin="0,0,5,0" Padding="0,5" FontSize="11" Height="32"/>
                                <Button Grid.Column="1" Content="📤 Exportar" Command="{Binding ExportAllDatabaseCommand}" 
                                        Style="{StaticResource SecondaryButton}" Padding="0,5" FontSize="11" Height="32"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Pauta List -->
                <ListBox ItemsSource="{Binding Pautas}" SelectedItem="{Binding EditingPauta}" 
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Border" Background="#262b38" CornerRadius="8" Margin="0,0,0,10" Padding="12" BorderThickness="1" BorderBrush="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                          Visibility="{Binding DataContext.IsPautaMultiSelectMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                             Background="Transparent" BorderThickness="0" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                                     <TextBlock Text="{Binding CreatedAt, StringFormat='{}Creado: {0:dd/MM/yyyy}'}" Foreground="#64748b" FontSize="10" Margin="2,2,0,0"/>
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="🗑️" 
                                                        Command="{Binding DataContext.DeletePautaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource DangerButton}" Padding="5" Width="30" Height="30" FontSize="12"
                                                        Visibility="{Binding DataContext.IsPautaMultiSelectMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#6f42c1"/>
                                                <Setter TargetName="Border" Property="Background" Value="#2d3446"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main Editor -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- MultiSelect Bar -->
                <RowDefinition Height="*"/>    <!-- DataGrid Container -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

        <!-- Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Diseño de Estructura Dinámica" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                <TextBlock Text="Crea campos y secciones para tu pauta de auditoría." FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Selección Múltiple" IsChecked="{Binding IsMultiSelectMode}" 
                          Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="border" Background="#2d3446" CornerRadius="15" Padding="10,5" BorderBrush="#3d4456" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="icon" Text="▢" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#94a3b8" FontWeight="Bold"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#6f42c1"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#885cd1"/>
                                    <Setter TargetName="icon" Property="Text" Value="✅"/>
                                    <Setter TargetName="icon" Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>
                
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Button Content="+ CAMPO" Command="{Binding AddFieldCommand}" 
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="12,5"/>
                    <Button Content="📦 BOX" Command="{Binding AddSectionCommand}" 
                            Style="{StaticResource SecondaryButton}" Padding="12,5"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Actions Bar (MultiSelect) -->
        <Border Grid.Row="1" Background="#262b38" CornerRadius="8" Padding="12,6" Margin="0,0,0,10"
                BorderBrush="#6f42c1" BorderThickness="1"
                HorizontalAlignment="Stretch"
                Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <Border Background="#6f42c1" CornerRadius="10" Padding="10,2" Margin="0,0,20,0">
                    <TextBlock Text="MODO SELECCIÓN ACTIVO" VerticalAlignment="Center" FontWeight="Bold" FontSize="10" Foreground="White"/>
                </Border>
                <Button Content="✔️ Seleccionar Todo" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="15,8" FontSize="11"/>
                <Button Content="🗑️ Borrar Seleccionados" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,0" Padding="15,8" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Main Editor (Tabs) -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" 
                    SelectedIndex="{Binding SelectedTabIndex, FallbackValue=0}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13" FontWeight="Bold" Margin="15,5"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#1e222d"/>
                    <Setter Property="Foreground" Value="#94a3b8"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: ESTRUCTURA -->
            <TabItem Header="CAMPOS / ESTRUCTURA">
                <Border Background="{StaticResource CardBackground}" CornerRadius="0,8,8,8" Padding="2" BorderBrush="#2d3446" BorderThickness="1">
                    <DataGrid x:Name="EditorGrid" ItemsSource="{Binding Fields}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" SelectionMode="Single" RowHeight="45"
                              AllowDrop="True"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              PreviewMouseLeftButtonDown="EditorGrid_PreviewMouseLeftButtonDown"
                              MouseMove="EditorGrid_MouseMove"
                              Drop="EditorGrid_Drop">
                        <DataGrid.Columns>
                            
                            <!-- Checkbox for MultiSelect -->
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.Visibility>
                                    <Binding Path="Data.IsMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                                </DataGridTemplateColumn.Visibility>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Mover -->
                            <DataGridTemplateColumn Header="Mover" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="▲" Style="{StaticResource MoveButtonStyle}" 
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="▼" Style="{StaticResource MoveButtonStyle}" 
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Etiqueta / Nombre del Cuadro -->
                            <DataGridTemplateColumn Header="Etiqueta / Título del Cuadro" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource GridTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Tipo -->
                            <DataGridTemplateColumn Header="Tipo" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableTypes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                      SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <TextBlock Text="--- CUADRO ---" Foreground="#ffd166" FontWeight="Bold" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Configuración / Opciones -->
                            <DataGridTemplateColumn Header="Configuración" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⚙️ CONFIG" 
                                                Command="{Binding DataContext.ConfigureOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="#3d4456" Padding="5" Height="28" FontSize="10"
                                                VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Boolean">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Date">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Time">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Valor Predeterminado -->
                            <DataGridTemplateColumn Header="Predeterminado" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Text"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Numeric"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="TextArea"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <ComboBox SelectedItem="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding Options, Converter={StaticResource PrependOptionConverter}}">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Dropdown"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <ComboBox SelectedItem="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding Source={StaticResource BooleanOptions}, Converter={StaticResource PrependOptionConverter}}">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Boolean"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <Button Command="{Binding DataContext.PickDateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonBase}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="Date"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding DefaultValue, FallbackValue='(Ninguno)'}" Foreground="White"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.PickTimeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonBase}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="Time"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding DefaultValue, FallbackValue='(Ninguno)'}" Foreground="White"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Pers." Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding KeepValueOnReset, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Obl." Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsRequired, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="ELIMINAR" Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="5" FontSize="9"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#1e222d" Margin="0,15,0,0" Padding="15" CornerRadius="8" BorderBrush="#2d3446" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Pauta Individual:" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                    <Button Content="📥 Importar Config" Command="{Binding ImportConfigCommand}" 
                            Style="{StaticResource GhostButton}" Margin="0,0,5,0" Padding="15,5" Height="32"/>
                    <Button Content="📤 Exportar Config" Command="{Binding ExportConfigCommand}" 
                            Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Padding="15,5" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Button Content="CANCELAR" Click="CancelButton_Click" Margin="0,0,15,0" Style="{StaticResource GhostButton}" Padding="15,8"/>
                    <Button Content="💾 GUARDAR CAMBIOS" 
                            Click="SaveButton_Click" Height="40" Padding="25,0" 
                            Style="{StaticResource SuccessButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Grid>
</Window>
