<Window x:Class="PautaDinamicaApp.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PautaDinamicaApp.ViewModels"
        xmlns:models="clr-namespace:PautaDinamicaApp.Models"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        xmlns:views="clr-namespace:PautaDinamicaApp.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Diseñador de Pauta" Height="700" Width="1150"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    


    <Window.Resources>
        <ResourceDictionary>
            <conv:PrependOptionConverter x:Key="PrependOptionConverter"/>
            <conv:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter"/>
            <conv:FieldTypeDisplayNameConverter x:Key="FieldTypeDisplayNameConverter"/>
            <conv:DictConverter x:Key="DictConverter"/>
            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:FieldIdsToNamesConverter x:Key="FieldIdsToNamesConverter"/>
            <x:Array x:Key="BooleanOptions" Type="{x:Type sys:String}">
                <sys:String>1</sys:String>
                <sys:String>0</sys:String>
            </x:Array>
            <SolidColorBrush x:Key="SeparatorBackground" Color="#003566"/>
            <DynamicResource x:Key="CardBackground" ResourceKey="CardBackgroundBrush"/>
            <DynamicResource x:Key="RowAlternatingBackground" ResourceKey="BackgroundBrush"/>
            <conv:BindingProxy x:Key="Proxy" Data="{Binding}"/>



            <!-- Prevenir que el DataGrid ponga fondos blancos o azules al seleccionar -->
            <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource CardBackgroundBrush}"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#007bff"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>


            <Style x:Key="FieldRowStyle" TargetType="DataGridRow">
                <Setter Property="Margin" Value="0,1"/>
                <Style.Triggers>
                    <!-- Solo aplicar si el objeto tiene propiedad Type (para FieldDefinition y ExportColumnConfig) -->
                    <DataTrigger Binding="{Binding Type}" Value="Separator">
                        <Setter Property="Background" Value="{StaticResource SeparatorBackground}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MoveButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="1"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <!-- Templates for Default Value Column to fix binding/virtualization issues -->
            <DataTemplate x:Key="TextDefaultValueTemplate">
                 <TextBox Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" 
                          Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}" 
                          BorderThickness="1" BorderBrush="{DynamicResource InputBorder}" Padding="5"/>
            </DataTemplate>

            <DataTemplate x:Key="DropdownDefaultValueTemplate">
                 <ComboBox SelectedItem="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                           ItemsSource="{Binding Options, Converter={StaticResource PrependOptionConverter}}"
                           Style="{StaticResource {x:Type ComboBox}}">
                     <ComboBox.ItemTemplate>
                         <DataTemplate>
                             <Grid>
                                 <TextBlock Text="{Binding}" x:Name="MainText"/>
                                 <TextBlock Text="(Ninguno)" x:Name="Placeholder" Visibility="Collapsed" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                             </Grid>
                             <DataTemplate.Triggers>
                                 <DataTrigger Binding="{Binding}" Value="">
                                     <Setter TargetName="MainText" Property="Visibility" Value="Collapsed"/>
                                     <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                 </DataTrigger>
                             </DataTemplate.Triggers>
                         </DataTemplate>
                     </ComboBox.ItemTemplate>
                 </ComboBox>
            </DataTemplate>

            <DataTemplate x:Key="BooleanDefaultValueTemplate">
                 <ComboBox SelectedItem="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                           ItemsSource="{Binding Source={StaticResource BooleanOptions}, Converter={StaticResource PrependOptionConverter}}"
                           Style="{StaticResource {x:Type ComboBox}}">
                     <ComboBox.ItemTemplate>
                         <DataTemplate>
                             <Grid>
                                 <TextBlock Text="{Binding}" x:Name="MainText"/>
                                 <TextBlock Text="(Ninguno)" x:Name="Placeholder" Visibility="Collapsed" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                             </Grid>
                             <DataTemplate.Triggers>
                                 <DataTrigger Binding="{Binding}" Value="">
                                     <Setter TargetName="MainText" Property="Visibility" Value="Collapsed"/>
                                     <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                 </DataTrigger>
                                 <DataTrigger Binding="{Binding}" Value="1">
                                     <Setter TargetName="MainText" Property="Text" Value="SÍ (1)"/>
                                 </DataTrigger>
                                 <DataTrigger Binding="{Binding}" Value="0">
                                     <Setter TargetName="MainText" Property="Text" Value="NO (0)"/>
                                 </DataTrigger>
                             </DataTemplate.Triggers>
                         </DataTemplate>
                     </ComboBox.ItemTemplate>
                 </ComboBox>
            </DataTemplate>

            <DataTemplate x:Key="TimeDefaultValueTemplate">
                 <Button Command="{Binding DataContext.PickTimeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                         Style="{StaticResource SecondaryButton}" Padding="8,4" HorizontalContentAlignment="Left"
                         Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Foreground="{DynamicResource TextBrush}" BorderThickness="1">
                      <TextBlock Text="{Binding DefaultValue, FallbackValue='(Seleccionar Hora)'}"/>
                 </Button>
            </DataTemplate>

            <DataTemplate x:Key="DateDefaultValueTemplate">
                 <Button Command="{Binding DataContext.PickDateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                         Style="{StaticResource SecondaryButton}" Padding="8,4" HorizontalContentAlignment="Left"
                         Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Foreground="{DynamicResource TextBrush}" BorderThickness="1">
                      <TextBlock Text="{Binding DefaultValue, FallbackValue='(Seleccionar Fecha)'}"/>
                 </Button>
            </DataTemplate>

            <DataTemplate x:Key="EmptyDefaultValueTemplate">
                 <Grid/>
            </DataTemplate>

            <views:FieldDefaultValueTemplateSelector x:Key="DefaultValueSelector"
                 TextTemplate="{StaticResource TextDefaultValueTemplate}"
                 DropdownTemplate="{StaticResource DropdownDefaultValueTemplate}"
                 BooleanTemplate="{StaticResource BooleanDefaultValueTemplate}"
                 TimeTemplate="{StaticResource TimeDefaultValueTemplate}"
                 DateTemplate="{StaticResource DateDefaultValueTemplate}"
                 EmptyTemplate="{StaticResource EmptyDefaultValueTemplate}"/>

            <!-- Reusable MultiSelect Toggle Style -->
            <Style x:Key="MultiSelectToggleStyle" TargetType="CheckBox">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="15,8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" SnapsToDevicePixels="True" Height="34">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="icon" Text="▢" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="14"/>
                                    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="icon" Property="Text" Value="✅"/>
                                    <Setter TargetName="icon" Property="Foreground" Value="White"/>
                                    <Setter Property="TextElement.Foreground" Value="White" TargetName="border"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Side Management (Pautas) -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Gestión de Pautas" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,20"/>

                <!-- Actions for Pautas -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                    <Grid Margin="0,0,0,10">
                        <CheckBox Content="Selección Múltiple" IsChecked="{Binding IsPautaMultiSelectMode}" 
                                  Style="{StaticResource MultiSelectToggleStyle}" HorizontalAlignment="Left"
                                  Visibility="{Binding IsPautaMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        
                        <Grid Visibility="{Binding IsPautaMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="✔️ Seleccionar Todo" Command="{Binding SelectAllPautasCommand}" 
                                    Style="{StaticResource GhostButton}" Margin="0,0,5,0" Padding="3,5" FontSize="11"
                                    ToolTip="Seleccionar todas las pautas"/>
                            <Button Grid.Column="1" Content="🗑️ Borrar" Command="{Binding DeleteSelectedPautasCommand}" 
                                    Style="{StaticResource DangerButton}" Padding="5" FontSize="11"
                                    ToolTip="Eliminar permanentemente"/>
                            <Button Grid.Column="2" Content="❌" Command="{Binding TogglePautaMultiSelectCommand}" 
                                    Style="{StaticResource GhostButton}" Margin="5,0,0,0" Padding="8,5" FontSize="11" FontWeight="Bold"/>
                        </Grid>
                    </Grid>
                    <Button Content="+ Nueva Pauta" Command="{Binding AddPautaCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,15" Height="40"/>

                    <!-- Base de Datos (Sistema) -->
                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TODAS LAS PAUTAS" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="📥 Importar" Command="{Binding ImportAllDatabaseCommand}" 
                                        Style="{StaticResource GhostButton}" Margin="0,0,5,0" Padding="0,5" FontSize="11" Height="32"/>
                                <Button Grid.Column="1" Content="📤 Exportar" Command="{Binding ExportAllDatabaseCommand}" 
                                        Style="{StaticResource SecondaryButton}" Padding="0,5" FontSize="11" Height="32"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Pauta List -->
                <ListBox x:Name="PautaList" ItemsSource="{Binding Pautas}" 
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,10,0,0"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="PautaList_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="PautaList_PreviewMouseLeftButtonUp"
                         MouseMove="PautaList_MouseMove"
                         Drop="PautaList_Drop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="DragEnter" Handler="PautaItem_DragEnter"/>
                            <EventSetter Event="DragLeave" Handler="PautaItem_DragLeave"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Border" Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Margin="0,0,0,12" Padding="12" BorderThickness="1.2" BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <CheckBox Grid.Column="0" Grid.RowSpan="2" IsChecked="{Binding IsSelected}" Margin="0,0,12,0" VerticalAlignment="Center"
                                                          Visibility="{Binding DataContext.IsPautaMultiSelectMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <!-- Row 1: Name -->
                                                    <Grid Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="15"
                                                                   Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBox x:Name="RenameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}" 
                                                                 FontWeight="Bold" FontSize="15" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                 KeyDown="PautaNameTextBox_KeyDown" LostFocus="PautaNameTextBox_LostFocus"
                                                                 IsVisibleChanged="RenameTextBox_IsVisibleChanged"
                                                                 Padding="2"/>
                                                    </Grid>

                                                    <!-- Row 2: Date -->
                                                     <TextBlock Text="{Binding CreatedAt, StringFormat='{}Creado: {0:dd/MM/yyyy}'}" 
                                                                Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Opacity="0.7"
                                                                TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                                     
                                                    <!-- Row 3: Actions -->
                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                 Visibility="{Binding DataContext.IsPautaMultiSelectMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                         <Button Content="✏️" 
                                                                 Command="{Binding DataContext.RenamePautaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                                 CommandParameter="{Binding}" 
                                                                 Style="{StaticResource GhostButton}" Padding="4" Width="28" Height="28" FontSize="11" Margin="0,0,6,0"
                                                                 ToolTip="Editar Nombre"/>
                                                         <Button Content="📑" 
                                                                 Command="{Binding DataContext.DuplicatePautaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                                 CommandParameter="{Binding}" 
                                                                 Style="{StaticResource GhostButton}" Padding="4" Width="28" Height="28" FontSize="11" Margin="0,0,6,0"
                                                                 ToolTip="Duplicar Pauta"/>
                                                         <Button Content="🗑️" 
                                                                 Command="{Binding DataContext.DeletePautaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                                 CommandParameter="{Binding}" 
                                                                 Style="{StaticResource DangerButton}" Padding="4" Width="28" Height="28" FontSize="11"
                                                                 ToolTip="Eliminar permanentemente"/>
                                                     </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main Editor -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- MultiSelect Bar -->
                <RowDefinition Height="*"/>    <!-- DataGrid Container -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

        <!-- Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Diseño de Estructura Dinámica" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="Crea campos y secciones para tu pauta de auditoría." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>

        </Grid>


        <!-- Main Editor (Tabs) -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" 
                    SelectedIndex="{Binding SelectedTabIndex, FallbackValue=0}">
            <!-- TAB 1: ESTRUCTURA -->            <TabItem Header="CAMPOS / ESTRUCTURA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Acciones de Campos (Movidas dentro del tab) -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                        
                        <!-- Panel de Acciones MultiSelect (Visible solo en modo multiselección) -->
                         <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="12,6" Margin="0,0,15,0"
                                 BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2"
                                 Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                             <StackPanel Orientation="Horizontal">
                                 <Button Content="▲" Command="{Binding MoveUpCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,6,0" Width="34" Height="30" ToolTip="Mover arriba" Padding="0"/>
                                 <Button Content="▼" Command="{Binding MoveDownCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,12,0" Width="34" Height="30" ToolTip="Mover abajo" Padding="0"/>
                                 <Button Content="Seleccionar Todo" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Height="30" Padding="12,0" FontSize="11"/>
                                 <Button Content="🗑️ Borrar" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Height="30" Padding="12,0" FontSize="11" ToolTip="Eliminar permanentemente"/>
                             </StackPanel>
                         </Border>

                        <CheckBox Content="Selección Múltiple" IsChecked="{Binding IsMultiSelectMode}" 
                                  Style="{StaticResource MultiSelectToggleStyle}"/>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" Margin="15,0,0,0">
                            <Button Content="➕ Nuevo campo" Command="{Binding AddFieldCommand}" 
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="12,5" Height="34"/>
                            <Button Content="📦 Nueva sección" Command="{Binding AddSectionCommand}" 
                                    Style="{StaticResource SecondaryButton}" Padding="12,5" Height="34"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0,8,8,8" Padding="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DataGrid x:Name="EditorGrid" ItemsSource="{Binding Fields}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" SelectionMode="Single" RowHeight="45"
                              AllowDrop="True" HeadersVisibility="Column"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ItemContainerStyle="{StaticResource FieldRowStyle}"
                              ScrollViewer.CanContentScroll="False"
                              EnableRowVirtualization="False"
                              PreviewMouseLeftButtonDown="EditorGrid_PreviewMouseLeftButtonDown"
                              MouseMove="EditorGrid_MouseMove"
                              Drop="EditorGrid_Drop">
                        <DataGrid.Columns>
                            
                            <!-- Checkbox for MultiSelect -->
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.Visibility>
                                    <Binding Path="Data.IsMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                                </DataGridTemplateColumn.Visibility>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Mover -->
                            <DataGridTemplateColumn Header="Mover" Width="60">
                                <DataGridTemplateColumn.Visibility>
                                    <Binding Path="Data.IsMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}" ConverterParameter="Inverse"/>
                                </DataGridTemplateColumn.Visibility>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="▲" Style="{StaticResource MoveButtonStyle}" 
                                                    Margin="0,0,4,0"
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="▼" Style="{StaticResource MoveButtonStyle}" 
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                             <!-- Etiqueta / Nombre del Cuadro -->
                            <DataGridTemplateColumn Header="Etiqueta / Título del Cuadro" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="5,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Tipo -->
                            <DataGridTemplateColumn Header="Tipo" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                             <ComboBox ItemsSource="{Binding DataContext.AvailableTypes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                       SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                       HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                 <ComboBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <TextBlock Text="{Binding Converter={StaticResource FieldTypeDisplayNameConverter}}"/>
                                                     </DataTemplate>
                                                 </ComboBox.ItemTemplate>
                                                 <ComboBox.Style>
                                                     <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </ComboBox.Style>
                                             </ComboBox>
                                             <TextBlock Text="--- SECCIÓN ---" Foreground="#ffd166" FontWeight="Bold" 
                                                        VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Configuración / Opciones -->
                             <DataGridTemplateColumn Header="Ajustes" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⚙️ CONFIG" 
                                                Command="{Binding DataContext.ConfigureOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Padding="5" Height="28" FontSize="10"
                                                VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Boolean">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Date">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Time">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Valor Predeterminado (Optimized) -->
                             <DataGridTemplateColumn Header="Predeterminado" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource TextDefaultValueTemplate}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Dropdown">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource DropdownDefaultValueTemplate}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Boolean">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource BooleanDefaultValueTemplate}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Date">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource DateDefaultValueTemplate}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Time">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource TimeDefaultValueTemplate}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource EmptyDefaultValueTemplate}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Calculation">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource EmptyDefaultValueTemplate}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Average">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource EmptyDefaultValueTemplate}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Pers." Width="50">
                                 <DataGridTemplateColumn.HeaderStyle>
                                     <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                         <Setter Property="ToolTip" Value="El contenido persiste aunque agregues un nuevo registro (no se limpia)"/>
                                     </Style>
                                 </DataGridTemplateColumn.HeaderStyle>
                                 <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding KeepValueOnReset, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Calculation">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Average">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                             <DataGridTemplateColumn Header="Obl." Width="40">
                                 <DataGridTemplateColumn.HeaderStyle>
                                     <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                         <Setter Property="ToolTip" Value="Campo obligatorio"/>
                                     </Style>
                                 </DataGridTemplateColumn.HeaderStyle>
                                 <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsRequired, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Calculation">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Average">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                         <Button Content="🗑️" Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                 CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="5" Width="28" Height="28" FontSize="12"
                                                 ToolTip="Eliminar permanentemente"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: INSTRUCCIONES DE APOYO -->
            <TabItem Header="INSTRUCCIONES DE APOYO">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0,8,8,8" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Criterios e Instrucciones de la Pauta" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="Este texto aparecerá al presionar el botón '?' en la pantalla principal para guiar al usuario." 
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15"/>

                            <TextBox Text="{Binding EditingPauta.HelpContent, UpdateSourceTrigger=PropertyChanged}" 
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}" Padding="10" FontSize="14"
                                     MinHeight="400" VerticalScrollBarVisibility="Auto"
                                     CaretBrush="{DynamicResource CaretBrush}"
                                     ToolTip="Puede usar Texto Plano, HTML básico o Markdown."/>

                            <Border Background="{DynamicResource CardBackgroundBrush}" Padding="12" CornerRadius="8" Margin="0,15,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="💡 Tip de Formato:" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Use # para Títulos, ** para negrita, * para listas." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                    <TextBlock Text="• También puede usar HTML (ej: &lt;b&gt;texto&lt;/b&gt;, &lt;br/&gt;, &lt;ul&gt;&lt;li&gt;...)." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Export Configuration -->
            <TabItem Header="CONFIG. EXPORTACIÓN">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Configuración de Reporte Excel" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/>
                        <TextBlock Text="Personalice el orden y nombres de las columnas para el reporte Excel." 
                                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                             <TextBlock Text="Configuración:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                             <ComboBox ItemsSource="{Binding ExportPresets}" 
                                       SelectedItem="{Binding SelectedExportPreset}"
                                       DisplayMemberPath="Name"
                                       Width="220" Height="36" Margin="0,0,8,0"
                                       Style="{StaticResource {x:Type ComboBox}}"/>
                            
                             <TextBox Text="{Binding SelectedExportPreset.Name, UpdateSourceTrigger=PropertyChanged}"
                                      Width="180" Height="36" Margin="0,0,12,0" 
                                      VerticalContentAlignment="Center" Padding="8,0"
                                      ToolTip="Cambiar nombre de esta configuración"
                                      Visibility="{Binding SelectedExportPreset, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                            
                             <Button Content="+" Command="{Binding AddPresetCommand}" 
                                     Style="{StaticResource SuccessButton}" Width="36" Height="36" Margin="0,0,5,0" Padding="0" FontSize="20" ToolTip="Nueva Configuración"/>
                             <Button Content="−" Command="{Binding RemovePresetCommand}" CommandParameter="{Binding SelectedExportPreset}"
                                     Style="{StaticResource DangerButton}" Width="36" Height="36" Margin="0,0,20,0" Padding="0" FontSize="22" ToolTip="Eliminar Configuración"/>

                             <Button Content="↺ Restablecer" Command="{Binding ResetExportConfigCommand}" Style="{StaticResource GhostButton}" Height="36" Padding="15,0"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                             <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="10,4" Margin="0,0,10,0"
                                     BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                     Visibility="{Binding IsExportMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                 <StackPanel Orientation="Horizontal">
                                     <Button Content="▲" Command="{Binding MoveExportUpCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,5,0" Width="34" Height="30" Padding="0"/>
                                     <Button Content="▼" Command="{Binding MoveExportDownCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,10,0" Width="34" Height="30" Padding="0"/>
                                     <Button Content="Seleccionar Todo" Command="{Binding SelectAllExportCommand}" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" FontSize="11"/>
                                 </StackPanel>
                             </Border>
                             <CheckBox Content="Selección Múltiple" IsChecked="{Binding IsExportMultiSelectMode}" 
                                       Style="{StaticResource MultiSelectToggleStyle}"/>
                         </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <DataGrid x:Name="ExportGrid" ItemsSource="{Binding ExportColumns}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" SelectionUnit="FullRow"
                                  ItemContainerStyle="{StaticResource FieldRowStyle}"
                                  ScrollViewer.CanContentScroll="False"
                                  EnableRowVirtualization="False"
                                  RowHeight="42">
                            
                            <DataGrid.Columns>
                                <!-- Selection Checkbox -->
                                <DataGridTemplateColumn Width="45">
                                    <DataGridTemplateColumn.Visibility>
                                        <Binding Path="Data.IsExportMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                                    </DataGridTemplateColumn.Visibility>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Move Up/Down -->
                                <DataGridTemplateColumn Width="85" Header="Mover">
                                    <DataGridTemplateColumn.Visibility>
                                        <Binding Path="Data.IsExportMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}" ConverterParameter="Inverse"/>
                                    </DataGridTemplateColumn.Visibility>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="▲" Command="{Binding DataContext.MoveExportUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource MoveButtonStyle}" Margin="0,0,4,0"/>
                                                <Button Content="▼" Command="{Binding DataContext.MoveExportDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource MoveButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Ignorar / Check -->
                                <DataGridTemplateColumn Header="Exportar" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsExportEnabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                      ToolTip="Si se desmarca, este campo será ignorado en el Excel."/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Original Label -->
                                <DataGridTextColumn Header="Campo Original" Binding="{Binding OriginalLabel}" IsReadOnly="True" Width="300" Foreground="{DynamicResource SecondaryTextBrush}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExportEnabled}" Value="False">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Custom Header -->
                                <DataGridTemplateColumn Header="Nombre en Excel (Editable)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding CustomHeader, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" 
                                                     BorderThickness="0" Foreground="{DynamicResource TextBrush}" Padding="8,4">
                                                 <TextBox.Style>
                                                     <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsExportEnabled}" Value="False">
                                                                 <Setter Property="IsEnabled" Value="False"/>
                                                                 <Setter Property="Opacity" Value="0.5"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBox.Style>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: PDF Configuration -->
            <TabItem Header="CONFIG. PDF">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header & Builder -->
                        <RowDefinition Height="Auto"/> <!-- Actions Bar -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Header & Filename Builder -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,5">
                        <TextBlock Text="Generación de Reporte PDF" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="Configure el nombre del archivo y los campos a incluir." 
                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>

                        <Border Background="{DynamicResource CardBackgroundBrush}" Padding="8,10" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Composición del Nombre del Archivo" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource CardBackgroundBrush}" Padding="12,6" CornerRadius="8" Margin="0,0,8,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="Reporte_" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                                        <ComboBox Width="180" Height="32" 
                                                  ItemsSource="{Binding Fields}"
                                                  SelectedValue="{Binding EditingPauta.PdfFileNameFieldId1}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Label">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                        </ComboBox>
                                         <Button Content="✕" Width="30" Height="32" Style="{StaticResource GhostButton}" Padding="0"
                                                 Click="ClearPdfField1_Click" ToolTip="Quitar campo" Margin="2,0,0,0" Foreground="{DynamicResource DangerBrush}"/>
                                    </StackPanel>

                                    <TextBlock Text="_" FontSize="20" FontWeight="Bold" Margin="4,0,12,8" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Opacity="0.5"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                                        <ComboBox Width="180" Height="32" 
                                                  ItemsSource="{Binding Fields}"
                                                  SelectedValue="{Binding EditingPauta.PdfFileNameFieldId2}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Label"/>
                                        <Button Content="✕" Width="30" Height="32" Style="{StaticResource GhostButton}" Padding="0"
                                                Click="ClearPdfField2_Click" ToolTip="Quitar campo" Margin="2,0,0,0" Foreground="{DynamicResource DangerBrush}"/>
                                    </StackPanel>

                                    <Border Background="{DynamicResource CardBackgroundBrush}" Padding="12,6" CornerRadius="8" Margin="0,0,8,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="_[Fecha_Hora].pdf" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                </WrapPanel>
                                
                                <TextBlock Text="* Los valores de los campos seleccionados se insertarán automáticamente en el nombre del archivo al exportar." 
                                           FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Actions Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <Button Content="↺ Restablecer Orden" Command="{Binding ResetPdfConfigCommand}" Style="{StaticResource GhostButton}" Height="34" Padding="15,0" Margin="0,0,10,0"/>
                            <TextBlock Text="Organice los campos arrastrando o usando las flechas." VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                             <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="10,4" Margin="0,0,10,0"
                                     BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                     Visibility="{Binding IsPdfMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                 <StackPanel Orientation="Horizontal">
                                     <Button Content="▲" Command="{Binding MovePdfUpCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,5,0" Width="34" Height="30" Padding="0"/>
                                     <Button Content="▼" Command="{Binding MovePdfDownCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,10,0" Width="34" Height="30" Padding="0"/>
                                     <Button Content="Seleccionar Todo" Command="{Binding SelectAllPdfCommand}" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" FontSize="11"/>
                                 </StackPanel>
                             </Border>
                             
                            <CheckBox Content="Selección Múltiple" IsChecked="{Binding IsPdfMultiSelectMode}" 
                                      Style="{StaticResource MultiSelectToggleStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <DataGrid x:Name="PdfGrid" ItemsSource="{Binding PdfColumns}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" SelectionUnit="FullRow"
                                  ItemContainerStyle="{StaticResource FieldRowStyle}"
                                  ScrollViewer.CanContentScroll="False"
                                  EnableRowVirtualization="False"
                                  RowHeight="42">
                            
                            <DataGrid.Columns>
                                <!-- MultiSelect Checkbox -->
                                <DataGridTemplateColumn Width="45">
                                    <DataGridTemplateColumn.Visibility>
                                        <Binding Path="Data.IsPdfMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                                    </DataGridTemplateColumn.Visibility>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Move Arrows -->
                                <DataGridTemplateColumn Width="85" Header="Mover">
                                    <DataGridTemplateColumn.Visibility>
                                        <Binding Path="Data.IsPdfMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}" ConverterParameter="Inverse"/>
                                    </DataGridTemplateColumn.Visibility>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="▲" Command="{Binding DataContext.MovePdfUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource MoveButtonStyle}" Margin="0,0,4,0"/>
                                                <Button Content="▼" Command="{Binding DataContext.MovePdfDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource MoveButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Include Checkbox -->
                                <DataGridTemplateColumn Header="Exportar" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsExportEnabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                      ToolTip="Si se desmarca, este campo no aparecerá en el PDF."/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Field Label -->
                                <DataGridTemplateColumn Header="Campo Original" Width="300">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="{Binding OriginalLabel}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="5,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExportEnabled}" Value="False">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="--- SECCIÓN / TÍTULO ---" Foreground="#ffd166" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExportEnabled}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Editable Name -->
                                <DataGridTemplateColumn Header="Nombre en PDF (Editable)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding CustomHeader, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" 
                                                     BorderThickness="0" Foreground="{DynamicResource TextBrush}" Padding="8,4">
                                                 <TextBox.Style>
                                                     <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsExportEnabled}" Value="False">
                                                                 <Setter Property="IsEnabled" Value="False"/>
                                                                 <Setter Property="Opacity" Value="0.5"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                                 <Setter Property="FontWeight" Value="Bold"/>
                                                                 <Setter Property="Foreground" Value="#ffd166"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBox.Style>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <!-- TAB: PDF REPLACEMENT RULES -->
            <TabItem Header="REGLAS PDF">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Reglas de Reemplazo PDF" FontSize="20" FontWeight="Bold" Margin="0,0,0,5" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Configure reglas para reemplazar valores y aplicar colores específicos en el reporte PDF." Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding IsPdfRuleMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <Button Content="+ Nueva Regla" 
                                        Command="{Binding AddPdfReplacementRuleCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Height="36" Padding="15,0"/>
                                
                                <Button Content="Selección Múltiple" 
                                        Command="{Binding TogglePdfRuleMultiSelectCommand}"
                                        Style="{StaticResource SecondaryButton}" Height="36" Padding="15,0"
                                        Visibility="{Binding EditingPauta.PdfReplacementRules.Count, Converter={StaticResource DictConverter}, ConverterParameter=0:Collapsed|Default:Visible}"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsPdfRuleMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Content="Eliminar Seleccionadas" 
                                        Command="{Binding DeleteSelectedPdfRulesCommand}"
                                        Style="{StaticResource DangerButton}" Margin="0,0,10,0" Height="36" Padding="15,0"/>
                                
                                <Button Content="Seleccionar Todo" 
                                        Command="{Binding SelectAllPdfRulesCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Height="36" Padding="15,0"/>

                                <Button Content="Cancelar" 
                                        Command="{Binding TogglePdfRuleMultiSelectCommand}"
                                        Style="{StaticResource GhostButton}" Height="36" Padding="15,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <DataGrid ItemsSource="{Binding EditingPauta.PdfReplacementRules}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column" 
                                      RowHeight="42"
                                      Background="Transparent"
                                      BorderThickness="0">
                                
                                <DataGrid.Columns>
                                    <!-- Checkbox -->
                                    <DataGridTemplateColumn Width="45" Visibility="{Binding Data.IsPdfRuleMultiSelectMode, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Campos Origen -->
                                    <DataGridTemplateColumn Header="Campos Afectados" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding Data.EditPdfRuleFieldsCommand, Source={StaticResource Proxy}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Center"
                                                        Padding="8,4" Margin="2"
                                                        ToolTip="Click para seleccionar los campos a los que aplica esta regla">
                                                     <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" 
                                                                   Foreground="{DynamicResource TextBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource FieldIdsToNamesConverter}">
                                                                    <Binding Path="TargetFieldIds" />
                                                                    <Binding Path="Data.Fields" Source="{StaticResource Proxy}" />
                                                                    <Binding Path="TargetFieldIds.Count" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Text="✏️" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.5"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Si Valor es... -->
                                    <DataGridTemplateColumn Header="Si el valor es..." Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="Transparent" BorderThickness="0" Padding="8,4" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <!-- Mostrar Texto... -->
                                    <DataGridTemplateColumn Header="Reemplazar por..." Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                 <TextBox Text="{Binding ReplacementValue, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="Transparent" BorderThickness="0" Padding="8,4" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <!-- Color -->
                                    <DataGridTemplateColumn Header="Color en PDF" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedValue="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" 
                                                          SelectedValuePath="Tag"
                                                          Height="32" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Tag="#000000"><StackPanel Orientation="Horizontal"><Border Width="12" Height="12" Background="#000000" Margin="0,0,8,0" BorderBrush="Gray" BorderThickness="1"/><TextBlock Text="Negro"/></StackPanel></ComboBoxItem>
                                                    <ComboBoxItem Tag="#28a745"><StackPanel Orientation="Horizontal"><Border Width="12" Height="12" Background="#28a745" Margin="0,0,8,0" BorderBrush="Gray" BorderThickness="1"/><TextBlock Text="Verde"/></StackPanel></ComboBoxItem>
                                                    <ComboBoxItem Tag="#dc3545"><StackPanel Orientation="Horizontal"><Border Width="12" Height="12" Background="#dc3545" Margin="0,0,8,0" BorderBrush="Gray" BorderThickness="1"/><TextBlock Text="Rojo"/></StackPanel></ComboBoxItem>
                                                    <ComboBoxItem Tag="#007bff"><StackPanel Orientation="Horizontal"><Border Width="12" Height="12" Background="#007bff" Margin="0,0,8,0" BorderBrush="Gray" BorderThickness="1"/><TextBlock Text="Azul"/></StackPanel></ComboBoxItem>
                                                    <ComboBoxItem Tag="#fd7e14"><StackPanel Orientation="Horizontal"><Border Width="12" Height="12" Background="#fd7e14" Margin="0,0,8,0" BorderBrush="Gray" BorderThickness="1"/><TextBlock Text="Naranja"/></StackPanel></ComboBoxItem>
                                                    <ComboBoxItem Tag="#6c757d"><StackPanel Orientation="Horizontal"><Border Width="12" Height="12" Background="#6c757d" Margin="0,0,8,0" BorderBrush="Gray" BorderThickness="1"/><TextBlock Text="Gris"/></StackPanel></ComboBoxItem>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <!-- Actions -->
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️" Command="{Binding Data.RemovePdfReplacementRuleCommand, Source={StaticResource Proxy}}" 
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}" Padding="0" Width="30" Height="30"
                                                        ToolTip="Eliminar regla"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" Margin="0,15,0,0" Padding="15" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Pauta Individual:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                    <Button Content="📥 Importar Config" Command="{Binding ImportConfigCommand}" 
                            Style="{StaticResource GhostButton}" Margin="0,0,5,0" Padding="15,5" Height="32"/>
                    <Button Content="📤 Exportar Config" Command="{Binding ExportConfigCommand}" 
                            Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Padding="15,5" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Button Content="CANCELAR" Click="CancelButton_Click" Margin="0,0,15,0" Style="{StaticResource GhostButton}" Padding="15,8"/>
                    <Button Content="APLICAR" Click="ApplyButton_Click" Margin="0,0,15,0" Style="{StaticResource SecondaryButton}" Padding="15,8" Height="40"/>
                    <Button Content="💾 GUARDAR CAMBIOS" 
                            Click="SaveButton_Click" Height="40" Padding="25,0" 
                            Style="{StaticResource SuccessButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Grid>
</Window>
