<Window x:Class="PautaDinamicaApp.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PautaDinamicaApp.ViewModels"
        xmlns:models="clr-namespace:PautaDinamicaApp.Models"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Diseñador de Pauta" Height="610" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="#12151c" Foreground="#e1e1e1">
    


    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/FieldTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:PrependOptionConverter x:Key="PrependOptionConverter"/>
            <x:Array x:Key="BooleanOptions" Type="{x:Type sys:String}">
                <sys:String>True</sys:String>
                <sys:String>False</sys:String>
            </x:Array>
            <conv:DictConverter x:Key="DictConverter"/>

            <SolidColorBrush x:Key="SeparatorBackground" Color="#003566"/>
            <SolidColorBrush x:Key="CardBackground" Color="#1e222d"/>
            <SolidColorBrush x:Key="RowAlternatingBackground" Color="#262b38"/>
            <conv:BindingProxy x:Key="Proxy" Data="{Binding}"/>



            <!-- Prevenir que el DataGrid ponga fondos blancos al seleccionar -->
            <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#3d4456"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#e1e1e1"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowBackground" Value="#1e222d"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAlternatingBackground}"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#007bff"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="GridTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#2d3446"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#3d4456"/>
                <Setter Property="Padding" Value="5,2"/>
                <Setter Property="CaretBrush" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Margin" Value="0,1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Type}" Value="Separator">
                        <Setter Property="Background" Value="{StaticResource SeparatorBackground}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MoveButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
                <Setter Property="Background" Value="#2d3446"/>
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- MultiSelect Bar -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Diseño de Estructura Dinámica" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Usa 'Mover' para ordenar. Los campos de tipo Dropdown requieren configuración de opciones." FontSize="12" Foreground="#94a3b8"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- CheckBox styled as a Toggle for better look -->
                <CheckBox Content="Selección Múltiple" IsChecked="{Binding IsMultiSelectMode}" 
                          Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="border" Background="#2d3446" CornerRadius="15" Padding="12,6" BorderBrush="#3d4456" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="icon" Text="▢" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#94a3b8" FontWeight="Bold"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#6f42c1"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#885cd1"/>
                                    <Setter TargetName="icon" Property="Text" Value="✅"/>
                                    <Setter TargetName="icon" Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>
                
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Button Content="+ AGREGAR CAMPO" Command="{Binding AddFieldCommand}" 
                            Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                    <Button Content="📦 NUEVO CUADRO (BOX)" Command="{Binding AddSectionCommand}" 
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Actions Bar (MultiSelect) -->
        <Border Grid.Row="1" Background="#262b38" CornerRadius="8" Padding="12,6" Margin="0,0,0,10"
                BorderBrush="#6f42c1" BorderThickness="1"
                HorizontalAlignment="Stretch"
                Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <Border Background="#6f42c1" CornerRadius="10" Padding="10,2" Margin="0,0,20,0">
                    <TextBlock Text="MODO SELECCIÓN ACTIVO" VerticalAlignment="Center" FontWeight="Bold" FontSize="10" Foreground="White"/>
                </Border>
                <Button Content="✔️ Seleccionar Todo" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="15,8" FontSize="11"/>
                <Button Content="🗑️ Borrar Seleccionados" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,0" Padding="15,8" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Editor Table -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="10" BorderBrush="#2d3446" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Fields}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" SelectionMode="Single" RowHeight="45">
                <DataGrid.Columns>
                    
                    <!-- Checkbox for MultiSelect -->
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.Visibility>
                            <Binding Path="Data.IsMultiSelectMode" Source="{StaticResource Proxy}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                        </DataGridTemplateColumn.Visibility>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Mover -->
                    <DataGridTemplateColumn Header="Mover" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="▲" Style="{StaticResource MoveButtonStyle}" 
                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="▼" Style="{StaticResource MoveButtonStyle}" 
                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Etiqueta / Nombre del Cuadro -->
                    <DataGridTemplateColumn Header="Etiqueta / Título del Cuadro" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource GridTextBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <!-- Tipo -->
                    <DataGridTemplateColumn Header="Tipo" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableTypes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <TextBlock Text="--- CUADRO ---" Foreground="#ffd166" FontWeight="Bold" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Configuración / Opciones -->
                    <DataGridTemplateColumn Header="Configuración" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="⚙️ CONFIGURAR" 
                                        Command="{Binding DataContext.ConfigureOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="#3d4456" Padding="10,5" Height="30" FontSize="11"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
                                            <!-- Mostrar botón para campos que requieren configuración extra -->
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Text">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Numeric">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Boolean">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Date">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Time">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Valor Predeterminado -->
                    <DataGridTemplateColumn Header="Predeterminado" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- TEXT & NUMERIC: TextBox -->
                                    <TextBox Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" 
                                             ToolTip="Valor inicial">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Text">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Numeric">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Date">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Time">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <!-- DROPDOWN: ComboBox with Options -->
                                    <ComboBox SelectedItem="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding Options, Converter={StaticResource PrependOptionConverter}}"
                                              Height="30" VerticalAlignment="Center">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Dropdown">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="">
                                                                    <Setter Property="Text" Value="(Ninguno)"/>
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                    <Setter Property="Opacity" Value="0.6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- BOOLEAN: ComboBox with True/False -->
                                    <ComboBox SelectedItem="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding Source={StaticResource BooleanOptions}, Converter={StaticResource PrependOptionConverter}}"
                                              Height="30" VerticalAlignment="Center">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Boolean">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="">
                                                                    <Setter Property="Text" Value="(Ninguno)"/>
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                    <Setter Property="Opacity" Value="0.6"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="True">
                                                                    <Setter Property="Text" Value="Marcado (1)"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="False">
                                                                    <Setter Property="Text" Value="Desmarcado (0)"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- DATE: Selector -->
                                    <Button Command="{Binding DataContext.PickDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="#2d3446" BorderBrush="#3d4456" BorderThickness="1"
                                            Height="30" VerticalAlignment="Center" Padding="8,0"
                                            ToolTip="Click para configurar fecha automática">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Date">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding DefaultValue}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DefaultValue}" Value="">
                                                                <Setter Property="Text" Value="(Ninguno)"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DefaultValue}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="(Ninguno)"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="📅" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- TIME: Selector -->
                                    <Button Command="{Binding DataContext.PickTimeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="#2d3446" BorderBrush="#3d4456" BorderThickness="1"
                                            Height="30" VerticalAlignment="Center" Padding="8,0"
                                            ToolTip="Click para configurar hora automática">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Time">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding DefaultValue}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DefaultValue}" Value="">
                                                                <Setter Property="Text" Value="(Ninguno)"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DefaultValue}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="(Ninguno)"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="🕒" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Persistente -->
                    <DataGridTemplateColumn Header="Persist." Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding KeepValueOnReset, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="Si se marca, el valor NO se borrará al agregar un nuevo ticket (mantiene el anterior).">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Calculation">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Average">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Obligatorio -->
                    <DataGridTemplateColumn Header="Obl." Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsRequired, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Separator">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Eliminar -->
                    <DataGridTemplateColumn Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="ELIMINAR" Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" Style="{StaticResource DangerButton}"
                                        Padding="5" FontSize="9"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="📥 IMPORTAR JSON" Command="{Binding ImportConfigCommand}" 
                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="15,0" Height="40"/>
                <Button Content="📤 EXPORTAR JSON" Command="{Binding ExportConfigCommand}" 
                        Style="{StaticResource ExcelButton}" Padding="15,0" Height="40"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCELAR" IsCancel="True" Margin="0,0,15,0" Style="{StaticResource GhostButton}"/>
                <Button Content="💾 GUARDAR CAMBIOS" 
                        Click="SaveButton_Click" Height="45" Padding="30,0" 
                        Style="{StaticResource SuccessButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
