<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PautaDinamicaApp.ViewModels"
                    xmlns:models="clr-namespace:PautaDinamicaApp.Models"
                    xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
                    xmlns:helpers="clr-namespace:PautaDinamicaApp.Services">

    <!-- Template para el Contador de Caracteres -->
    <DataTemplate x:Key="FieldCounterTemplate">
        <TextBlock HorizontalAlignment="Right" FontSize="9" Margin="0,1,2,0" Foreground="{DynamicResource SecondaryTextBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text">
                        <Setter.Value>
                            <MultiBinding StringFormat="{}{0} / {1}">
                                <Binding Path="CurrentLength"/>
                                <Binding Path="MaxLength"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MaxLength}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <!-- Label Template with Required Asterisk -->
    <DataTemplate x:Key="FieldLabelTemplate">
        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap" MaxWidth="240" HorizontalAlignment="Left" TextAlignment="Left">
            <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
            <Run Foreground="{StaticResource ErrorBrush}" FontSize="12">
                <Run.Style>
                    <Style TargetType="Run">
                        <Setter Property="Text" Value=""/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                <Setter Property="Text" Value=" *"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Run.Style>
            </Run>
        </TextBlock>
    </DataTemplate>


    <!-- Error Message Template -->
    <DataTemplate x:Key="FieldErrorTemplate">
        <TextBlock Text="{Binding ValidationError}" Foreground="{StaticResource ErrorBrush}" 
                   FontSize="10" Margin="0,2,0,0"
                   Visibility="{Binding IsValid, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
    </DataTemplate>

    <!-- Duplicate Warning Template (real-time red alert) -->
    <DataTemplate x:Key="FieldDuplicateWarningTemplate">
        <TextBlock Text="{Binding DuplicateWarning}" Foreground="{StaticResource ErrorBrush}" 
                   FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasDuplicateWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </DataTemplate>

    <!-- Estilo para TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsValid, FallbackValue=True}" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón para ComboBox (Define el aspecto del cuadro) -->
    <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Border x:Name="templateBorder" 
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8">
            <Grid HorizontalAlignment="Right" Width="30">
                <Path x:Name="Arrow" 
                      Fill="{DynamicResource SecondaryTextBrush}"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="templateBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Estilo para ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- El ToggleButton define TODO el fondo y el borde interactivamente -->
                        <ToggleButton x:Name="ToggleButton" 
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                      Focusable="false"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                        
                        <!-- El contenido se dibuja sobre el ToggleButton -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False" 
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />

                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" 
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"                
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        CornerRadius="0,0,8,8"
                                        Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
                                    </Border.Effect>
                                </Border>
                                <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="ToggleButton" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsValid, FallbackValue=True}" Value="False">
                            <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                            <Setter TargetName="ToggleButton" Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border Name="border" Background="{TemplateBinding Background}" 
                            BorderBrush="{DynamicResource InputBorder}" 
                            BorderThickness="1" CornerRadius="8">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" 
                                               Background="Transparent" Foreground="{DynamicResource InputForeground}"
                                               BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                            <Button x:Name="PART_Button" Grid.Column="1" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Width="30" Margin="0,0,5,0"
                                    Content="📅" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Template para Texto -->
    <DataTemplate x:Key="TextTemplate" DataType="{x:Type vm:DynamicFieldVM}">
        <StackPanel Margin="0,5">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <Grid>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="{Binding MaxLength}" 
                         Padding="8,5,35,5"
                         SpellCheck.IsEnabled="{Binding Path=DataContext.Settings.SpellCheckLanguage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotNullToBooleanConverter}}"
                         Language="{Binding Path=DataContext.Settings.SpellCheckLanguage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToLanguageConverter}, ConverterCulture='es-ES'}"/>
                <Button Command="{Binding OpenTemplatesCommand}" 
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Width="30" Height="25"
                        ToolTip="Insertar Plantilla"
                        Visibility="{Binding ShowTemplateButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="📑" Foreground="{DynamicResource AccentBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
            <Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldCounterTemplate}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldErrorTemplate}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldDuplicateWarningTemplate}"/>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Template para Numérico -->
    <DataTemplate x:Key="NumericTemplate" DataType="{x:Type vm:DynamicFieldVM}">
        <StackPanel Margin="0,5">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <Grid>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength}" Padding="8,5,35,5"/>
                <TextBlock Text="🔢" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" 
                           Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False" FontSize="14"
                           Opacity="0.5"/>
            </Grid>
            <Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldCounterTemplate}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldErrorTemplate}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldDuplicateWarningTemplate}"/>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Template para Booleano -->
    <DataTemplate x:Key="BooleanTemplate" DataType="{x:Type vm:DynamicFieldVM}">
        <StackPanel Margin="0,5">
            <CheckBox IsChecked="{Binding Value, Converter={StaticResource FlexibleBooleanConverter}}" 
                      Foreground="{DynamicResource InputForeground}"
                      Margin="0,8"
                      VerticalContentAlignment="Top">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,-1,0,0" FontSize="12" MaxWidth="210" HorizontalAlignment="Left" TextAlignment="Left"/>
            </CheckBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldErrorTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Template para Dropdown -->
    <DataTemplate x:Key="DropdownTemplate" DataType="{x:Type vm:DynamicFieldVM}">
        <StackPanel Margin="0,5">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <ComboBox ItemsSource="{Binding Options}" 
                      SelectedItem="{Binding Value}"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldErrorTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Template para Fecha -->
    <DataTemplate x:Key="DateTemplate" DataType="{x:Type vm:DynamicFieldVM}">
        <StackPanel Margin="0,5">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <Grid>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="8,5,35,5" MaxLength="{Binding MaxLength}"/>
                <Button Command="{Binding PickDateCommand}" 
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Width="30" Height="25"
                        Cursor="Hand">
                    <TextBlock Text="📅" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldErrorTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Template para Hora -->
    <DataTemplate x:Key="TimeTemplate" DataType="{x:Type vm:DynamicFieldVM}">
        <StackPanel Margin="0,5">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <Grid>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="8,5,35,5" MaxLength="{Binding MaxLength}"/>
                <Button Command="{Binding PickTimeCommand}" 
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Width="30" Height="25"
                        Cursor="Hand">
                    <TextBlock Text="🕒" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldErrorTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Template para Separador (Subcabecera dentro de un cuadro) -->
    <DataTemplate x:Key="SeparatorTemplate" DataType="{x:Type vm:DynamicFieldVM}">
        <StackPanel Margin="0,15,0,5">
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14"/>
            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,5,0,0"/>
        </StackPanel>
    </DataTemplate>

    <!-- Template para Cálculo / Porcentaje (Solo Lectura) -->
    <DataTemplate x:Key="CalculationTemplate" DataType="{x:Type vm:DynamicFieldVM}">
        <StackPanel Margin="0,5">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="4" Padding="10,8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,1,1,2">
                <TextBlock Text="{Binding Value, TargetNullValue='0.0%'}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- Template para Promedio (Solo Lectura) -->
    <DataTemplate x:Key="AverageTemplate" DataType="{x:Type vm:DynamicFieldVM}">
        <StackPanel Margin="0,5">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="4" Padding="10,8" BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1,1,1,2">
                <TextBlock Text="{Binding Value, TargetNullValue='0.0%'}" Foreground="{DynamicResource SecondaryBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- Template para TextArea -->
    <DataTemplate x:Key="TextAreaTemplate" DataType="{x:Type vm:DynamicFieldVM}">
        <StackPanel Margin="0,5">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <Grid>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                         Height="120" 
                         MinHeight="60"
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         MaxLength="{Binding MaxLength}"
                         Padding="8,5,35,5"
                         SpellCheck.IsEnabled="{Binding Path=DataContext.Settings.SpellCheckLanguage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotNullToBooleanConverter}}"
                         Language="{Binding Path=DataContext.Settings.SpellCheckLanguage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToLanguageConverter}, ConverterCulture='es-ES'}"/>
                
                <Button Command="{Binding OpenTemplatesCommand}" 
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Width="30" Height="25"
                        ToolTip="Insertar Plantilla"
                        Visibility="{Binding ShowTemplateButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="📑" Foreground="{DynamicResource AccentBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Tirador para redimensionar altura -->
                <Thumb Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                       Cursor="SizeNWSE" helpers:UIHelpers.EnableHeightResize="True">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Data="M10,0 L10,10 L0,10 Z" Fill="{DynamicResource AccentBrush}" Opacity="0.4" 
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
            <Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldCounterTemplate}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldErrorTemplate}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldDuplicateWarningTemplate}"/>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Template para Archivos Adjuntos -->
    <DataTemplate x:Key="FileAttachmentTemplate" DataType="{x:Type vm:DynamicFieldVM}">
        <StackPanel Margin="0,5">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <Grid>
                <Border x:Name="mainBorder" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <StackPanel>
                        <!-- Lista de archivos ya adjuntos -->
                        <ItemsControl ItemsSource="{Binding Paths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📎" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource FileNameConverter}}" 
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   ToolTip="{Binding}"/>
                                        <Button Grid.Column="2" Content="✕" 
                                                Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0" FontSize="10" Foreground="{DynamicResource ErrorBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Mensaje si no hay archivos -->
                        <TextBlock Text="No hay archivos adjuntos" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic" Margin="0,5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Paths.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Botones de Acción -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="+ Adjuntar" Command="{Binding AttachFileCommand}" Style="{StaticResource SuccessButton}" Height="30" Padding="12,0" FontSize="11" Margin="0,0,8,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldErrorTemplate}"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsValid}" Value="False">
                <Setter TargetName="mainBorder" Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                <Setter TargetName="mainBorder" Property="BorderThickness" Value="1.5"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
