<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters">

    <conv:DictConverter x:Key="DictConverter"/>
    <conv:DictionaryValueConverter x:Key="DictionaryValueConverter"/>
    <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <conv:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter"/>
    <conv:StringToBrushConverter x:Key="StringToBrushConverter"/>


    <!-- Design Tokens / Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#12151c"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1e222d"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2d3446"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#007bff"/>
    <SolidColorBrush x:Key="TextBrush" Color="#e1e1e1"/>
    <SolidColorBrush x:Key="InputForeground" Color="#e1e1e1"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="#28a745"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#dc3545"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#6f42c1"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#ffc107"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94a3b8"/>
    <SolidColorBrush x:Key="InputBackground" Color="#2d3446"/>
    <SolidColorBrush x:Key="InputBorder" Color="#3d4456"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#ff4d4d"/>

    <!-- Base Button Style -->
    <Style x:Key="ModernButtonBase" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
    </Style>

    <Style x:Key="ExcelButton" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="#217346"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4a5568"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
