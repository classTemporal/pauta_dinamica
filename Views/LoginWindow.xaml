<Window x:Class="PautaDinamicaApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso - Pauta Dinámica" Height="580" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" Foreground="{DynamicResource TextBrush}" WindowStyle="None" AllowsTransparency="True"
        Icon="pack://application:,,,/Assets/logo.ico">
    
    <Border CornerRadius="15" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Theme Toggle -->
            <Button Command="{Binding ToggleThemeCommand}" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Background="Transparent" BorderThickness="0" Margin="0,-20,-20,0" Cursor="Hand">
                <Path Data="{DynamicResource ThemeToggleIcon}" 
                      Fill="{DynamicResource AccentBrush}" Width="22" Height="22" Stretch="Uniform"/>
            </Button>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Pauta Dinámica" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Control de Auditoría" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Content -->
            <Grid Grid.Row="1">
                
                <!-- 1. EMPTY STATE (No users) -->
                <StackPanel VerticalAlignment="Center" 
                            Visibility="{Binding HasUsers, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Border Background="{DynamicResource InputBackground}" Padding="20" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Bienvenido" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No se han detectado perfiles de usuario en este equipo." 
                                       Margin="0,15,0,20" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <Button Content="CREAR PRIMER USUARIO" Command="{Binding ToggleManageModeCommand}" 
                                    Style="{StaticResource SuccessButton}" Height="45"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2. LOGIN VIEW -->
                <StackPanel Visibility="{Binding HasUsers, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding IsManageMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <TextBlock Text="Seleccionar Usuario:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" 
                                  DisplayMemberPath="Username" Height="42" Background="{DynamicResource InputBackground}" FontSize="14"/>

                        <StackPanel Margin="0,20,0,0" Visibility="{Binding SelectedUser.PasswordHash, Converter={StaticResource NotNullToVisibilityConverter}}">
                            <TextBlock Text="Contraseña:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <PasswordBox x:Name="MainUserPasswordBox" Height="42" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}" Padding="10,0" FontSize="14"/>
                            <Button Content="¿Olvidó su contraseña?" Command="{Binding ToggleMasterResetCommand}"
                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" FontSize="11" 
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Visibility="{Binding IsMasterResetMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        </StackPanel>

                        <TextBlock Text="Acceso sin contraseña habilitado." Foreground="{DynamicResource SuccessBrush}" Margin="0,20,0,0"
                                   HorizontalAlignment="Center" FontStyle="Italic" FontSize="12"
                                   Visibility="{Binding SelectedUser.PasswordHash, Converter={StaticResource NotNullToVisibilityConverter}, ConverterParameter=Inverse}"/>

                        <Border Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="15" Margin="0,20,0,0" 
                                Visibility="{Binding IsMasterResetMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="AUTORIZACIÓN REQUERIDA" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Clave de Administrador:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                                <PasswordBox x:Name="AdminRestoreBox" Height="35" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" Padding="8,0"/>
                                
                                <TextBlock Text="Nueva Contraseña:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,5"/>
                                <PasswordBox x:Name="ResetNewPasswordBox" Height="35" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" Padding="8,0"/>

                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="CANCELAR" Command="{Binding ToggleMasterResetCommand}" 
                                            Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Height="30"/>
                                    <Button Grid.Column="1" Content="ESTABLECER" Command="{Binding ResetPasswordCommand}" 
                                            Style="{StaticResource PrimaryButton}" Height="30" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="INGRESAR" Command="{Binding LoginCommand}" 
                                Style="{StaticResource PrimaryButton}" Height="50" Margin="0,30,0,10"
                                Visibility="{Binding IsMasterResetMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 3. MANAGEMENT MODE -->
                <StackPanel Visibility="{Binding IsManageMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="GESTIÓN DE CUENTAS" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    
                    <ScrollViewer Margin="0,15,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="350">
                        <StackPanel>
                            <!-- Section: Create -->
                            <Border Background="{DynamicResource InputBackground}" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Nuevo Perfil" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Usuario:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" Padding="10,0"/>

                                    <TextBlock Text="Contraseña:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,10,0,5"/>
                                    <PasswordBox x:Name="NewPasswordBox" Height="35" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" Padding="10,0"/>

                                    <Button Content="REGISTRAR" Command="{Binding CreateUserCommand}" 
                                            Style="{StaticResource SuccessButton}" Height="35" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Section: Delete -->
                            <Border Background="{DynamicResource InputBackground}" Padding="15" CornerRadius="8" Visibility="{Binding HasUsers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Eliminar Perfil" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
                                    <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" 
                                              DisplayMemberPath="Username" Height="35" Background="{DynamicResource BackgroundBrush}" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="Confirme con su clave de Admin / Usuario si tiene:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                                    <PasswordBox x:Name="AdminDeleteBox" Height="35" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" Padding="8,0"/>

                                    <Button Command="{Binding DeleteUserCommand}" CommandParameter="{Binding SelectedUser}"
                                            Style="{StaticResource DangerButton}" Content="BORRAR PERFIL" Height="35" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

            </Grid>

            <!-- Bottom Navigation -->
            <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Command="{Binding ToggleManageModeCommand}" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="{Binding IsManageMode, Converter={StaticResource StringSwitchConverter}, ConverterParameter='Cerrar Gestión|Administrar Usuarios'}" 
                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                </Button>
                
                <Button Content="Salir del Sistema" Click="Exit_Click" Background="Transparent" BorderThickness="0" 
                        Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

