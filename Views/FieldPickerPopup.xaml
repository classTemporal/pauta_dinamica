<Window x:Class="PautaDinamicaApp.Views.FieldPickerPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar campo dinámico" Height="470" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <!--
        Selector de campos de la pauta activa.
        Devuelve el placeholder en el mismo formato que usa EmailService, [Etiqueta],
        para que el token se resuelva al enviar el correo.
    -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Insertar campo de la pauta" FontSize="19" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Se insertará el marcador [Etiqueta] en la posición del cursor. Al enviar el correo se sustituye por el valor real del campo."/>

        <TextBox x:Name="SearchBox" Grid.Row="2" Height="32" VerticalContentAlignment="Center"
                 Margin="0,0,0,10" VerticalAlignment="Top"
                 TextChanged="SearchBox_TextChanged"/>

        <ListBox x:Name="FieldList" Grid.Row="2" Margin="0,42,0,0"
                 MouseDoubleClick="FieldList_MouseDoubleClick" HorizontalContentAlignment="Stretch">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,4"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Label}" FontSize="13"/>
                        <TextBlock Text="{Binding Id}" FontSize="10" Opacity="0.6"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancelar" Height="42" Margin="0,0,5,0"
                    Style="{DynamicResource DangerButton}" Click="CancelButton_Click" IsCancel="True"/>
            <Button Grid.Column="1" Content="Insertar" Height="42" Margin="5,0,0,0"
                    Style="{DynamicResource SuccessButton}" Click="OkButton_Click" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
