<Window x:Class="PautaDinamicaApp.Views.CreatePautaWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PautaDinamicaApp.ViewModels"
        xmlns:models="clr-namespace:PautaDinamicaApp.Models"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        xmlns:views="clr-namespace:PautaDinamicaApp.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Asistente: Crear Nueva Pauta" Height="650" Width="1000"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        MinWidth="800" MinHeight="550"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    
    <Window.Resources>
        <ResourceDictionary>
            <conv:FieldTypeDisplayNameConverter x:Key="FieldTypeDisplayNameConverter"/>
            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
            
            <conv:IntToStep0VisibilityConverter x:Key="IntToStep0VisibilityConverter"/>
            <conv:IntToStep1VisibilityConverter x:Key="IntToStep1VisibilityConverter"/>
            <conv:IntToStep2VisibilityConverter x:Key="IntToStep2VisibilityConverter"/>
            <conv:IntToHasPreviousStepConverter x:Key="IntToHasPreviousStepConverter"/>
            <conv:IntToNextOrFinishTextConverter x:Key="IntToNextOrFinishTextConverter"/>
            <conv:CanMoveToNextStepConverter x:Key="CanMoveToNextStepConverter"/>

            <!-- Card ItemContainer Style -->
            <Style x:Key="WizardCardListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12,10" BorderThickness="1.5" BorderBrush="Transparent"
                                    Cursor="Hand">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MoveButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="1"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <x:Array x:Key="BooleanOptions" Type="{x:Type sys:String}">
                <sys:String></sys:String>
                <sys:String>1</sys:String>
                <sys:String>0</sys:String>
            </x:Array>

            <DataTemplate x:Key="TextDefaultValueTemplate">
                <TextBox Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="24"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}"
                         BorderThickness="1" BorderBrush="{DynamicResource InputBorder}" Padding="5"/>
            </DataTemplate>

            <DataTemplate x:Key="DropdownDefaultValueTemplate">
                <ComboBox SelectedItem="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Options}"
                          Height="24"
                          Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Foreground="{DynamicResource TextBrush}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DataTemplate>

            <DataTemplate x:Key="BooleanDefaultValueTemplate">
                <ComboBox SelectedItem="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{StaticResource BooleanOptions}"
                          Height="24"
                          Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Foreground="{DynamicResource TextBrush}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DataTemplate>

            <DataTemplate x:Key="DateDefaultValueTemplate">
                <Button Command="{Binding DataContext.PickDateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                        Style="{StaticResource SecondaryButton}" Padding="6,2"
                        Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                        Width="120" Height="26" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📅" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Text="{Binding DefaultValue, FallbackValue='(Fecha)'}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="TimeDefaultValueTemplate">
                <Button Command="{Binding DataContext.PickTimeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                        Style="{StaticResource SecondaryButton}" Padding="6,2"
                        Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                        Width="120" Height="26" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕒" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Text="{Binding DefaultValue, FallbackValue='(Hora)'}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="EmptyDefaultValueTemplate">
                <Grid/>
            </DataTemplate>

            <views:FieldDefaultValueTemplateSelector x:Key="DefaultValueSelector"
                     TextTemplate="{StaticResource TextDefaultValueTemplate}"
                     DropdownTemplate="{StaticResource DropdownDefaultValueTemplate}"
                     BooleanTemplate="{StaticResource BooleanDefaultValueTemplate}"
                     TimeTemplate="{StaticResource TimeDefaultValueTemplate}"
                     DateTemplate="{StaticResource DateDefaultValueTemplate}"
                     EmptyTemplate="{StaticResource EmptyDefaultValueTemplate}"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="25,20">
            <StackPanel>
                <TextBlock Text="Asistente de Creación de Pauta" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Siga los pasos para configurar su nueva pauta de auditoría." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/>
                
                <!-- Steps -->
                <UniformGrid Margin="0,15,0,0" Rows="1" Columns="3" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Margin="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Height="90">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
                                            <TextBlock Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0" FontSize="12"/>
                                        <TextBlock Text="{Binding Description}" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Wizard Content -->
        <Grid Grid.Row="1" Margin="25,0">
            <!-- Step 0: Fields -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntToStep0VisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Pauta Name -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Nombre de la Pauta" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PautaName, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}"
                             BorderThickness="1" BorderBrush="{DynamicResource InputBorder}" Padding="8,5" Height="32"
                             ToolTip="Nombre identificativo de la pauta"/>
                </StackPanel>

                <!-- Field Actions -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Button Content="➕ Nuevo campo" Command="{Binding AddFieldCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="12,5" Height="34"/>
                    <Button Content="📦 Nueva sección" Command="{Binding AddSectionCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="12,5" Height="34"/>
                </StackPanel>

                <!-- Fields List -->
                <Border Grid.Row="2" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ListBox x:Name="FieldsList" ItemsSource="{Binding Fields}"
                             SelectionMode="Single"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource WizardCardListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Move -->
                                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <Button Content="▲" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource MoveButtonStyle}" ToolTip="Mover arriba"/>
                                        <Button Content="▼" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource MoveButtonStyle}" ToolTip="Mover abajo"/>
                                    </StackPanel>

                                    <!-- Label -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="ETIQUETA" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{DynamicResource InputBackground}" BorderThickness="1" BorderBrush="{DynamicResource InputBorder}" Foreground="{DynamicResource TextBrush}" Padding="6,4" Width="180" Height="26"/>
                                    </StackPanel>

                                    <!-- Type -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="TIPO" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Stretch" Height="26"
                                                  Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Foreground="{DynamicResource TextBrush}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FieldTypeDisplayNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Default Value -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="VAL. PREDET." FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <ContentControl Content="{Binding}" Height="24" Width="120">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource TextDefaultValueTemplate}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Dropdown"><Setter Property="ContentTemplate" Value="{StaticResource DropdownDefaultValueTemplate}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Boolean"><Setter Property="ContentTemplate" Value="{StaticResource BooleanDefaultValueTemplate}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Date"><Setter Property="ContentTemplate" Value="{StaticResource DateDefaultValueTemplate}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Time"><Setter Property="ContentTemplate" Value="{StaticResource TimeDefaultValueTemplate}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Separator"><Setter Property="ContentTemplate" Value="{StaticResource EmptyDefaultValueTemplate}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Calculation"><Setter Property="ContentTemplate" Value="{StaticResource EmptyDefaultValueTemplate}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Average"><Setter Property="ContentTemplate" Value="{StaticResource EmptyDefaultValueTemplate}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="FileAttachment"><Setter Property="ContentTemplate" Value="{StaticResource EmptyDefaultValueTemplate}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </StackPanel>

                                    <!-- Required -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="OBL." FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                        <CheckBox IsChecked="{Binding IsRequired, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <Button Content="⚙️ CONFIG" Command="{Binding DataContext.ConfigureOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Padding="8,4" Height="26" FontSize="10" ToolTip="Configurar opciones avanzadas"/>
                                        <Button Content="🗑️" Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}" Width="28" Height="28" Padding="0" FontSize="14" ToolTip="Eliminar"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Step 1: Dashboard Order -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntToStep1VisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Organice el orden de visualización de los campos en el dashboard principal del sistema." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>

                <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ListBox x:Name="DashboardFieldsList" ItemsSource="{Binding DashboardFields}"
                             SelectionMode="Single"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource WizardCardListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Move -->
                                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <Button Content="▲" Command="{Binding DataContext.MoveDashboardUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource MoveButtonStyle}" ToolTip="Mover arriba"/>
                                        <Button Content="▼" Command="{Binding DataContext.MoveDashboardDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource MoveButtonStyle}" ToolTip="Mover abajo"/>
                                    </StackPanel>

                                    <!-- Field Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource FieldTypeDisplayNameConverter}}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>

                                    <!-- Visibility Toggle -->
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" ToolTip="Mostrar/ocultar en dashboard"/>

                                    <!-- Remove from Dashboard -->
                                    <Button Grid.Column="3" Content="🗑️"
                                            Style="{StaticResource DangerButton}" Width="28" Height="28" Padding="0" FontSize="14" ToolTip="Quitar del dashboard"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Step 2: Email Configuration -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntToStep2VisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Email Method -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Método de Envío" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding EmailMethods}" SelectedItem="{Binding SelectedEmailMethod}" Width="200" Height="32"/>
                </StackPanel>

                <!-- Email Templates and Directory -->
                <TabControl Grid.Row="1" Margin="0,0,0,10">
                    <!-- Templates Tab -->
                    <TabItem Header="Plantillas de Correo">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Destinatario (To)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding EmailToTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}"
                                         BorderThickness="1" BorderBrush="{DynamicResource InputBorder}" Padding="8" Height="60"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="CC" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding EmailCcTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}"
                                         BorderThickness="1" BorderBrush="{DynamicResource InputBorder}" Padding="8" Height="60"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock Text="Asunto" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding EmailSubjectTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}"
                                         BorderThickness="1" BorderBrush="{DynamicResource InputBorder}" Padding="8" Height="60"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,0,0,0">
                                <TextBlock Text="Cuerpo del Mensaje" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding EmailBodyTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}"
                                         BorderThickness="1" BorderBrush="{DynamicResource InputBorder}" Padding="8">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="MinHeight" Value="100"/>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Recipient Directory Tab -->
                    <TabItem Header="Directorio de Contactos">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0" Content="Detección automática de destinatarios" IsChecked="{Binding UseAutomatedRecipient}" Margin="0,0,0,10"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding ShowContactDirectory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Campo para nombre:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                                <ComboBox ItemsSource="{Binding DataContext.Fields, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValue="{Binding EmailNameFieldId}" SelectedValuePath="Id" DisplayMemberPath="Label"
                                          Width="200" Height="28"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Contactos registrados" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                            <ListBox Grid.Row="2" ItemsSource="{Binding RecipientContacts}"
                                     Background="{DynamicResource BackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                     Visibility="{Binding ShowContactDirectory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="5" Height="24"
                                                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}" BorderThickness="1" BorderBrush="{DynamicResource InputBorder}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="5" Height="24"
                                                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}" BorderThickness="1" BorderBrush="{DynamicResource InputBorder}"/>
                                            <Button Grid.Column="2" Content="🗑️" Command="{Binding DataContext.RemoveContactCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}" Width="28" Height="28" Padding="0" FontSize="14" ToolTip="Eliminar contacto"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="3" Content="+ Agregar Contacto" Command="{Binding AddContactCommand}" Style="{StaticResource GhostButton}" Height="30" Padding="10,0"
                                    Visibility="{Binding ShowContactDirectory, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0"/>
                        </Grid>
                    </TabItem>

                    <!-- Exclusion Tab -->
                    <TabItem Header="Exclusión por Campo">
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Excluir cuando el campo:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Fields, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValue="{Binding ExcludeByFieldId}" SelectedValuePath="Id" DisplayMemberPath="Label" Height="26"/>
                                <TextBlock Grid.Column="2" Text="=" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                <TextBox Grid.Column="3" Text="{Binding ExcludeByFieldValue, UpdateSourceTrigger=PropertyChanged}" Height="26"
                                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}" BorderThickness="1" BorderBrush="{DynamicResource InputBorder}"/>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Footer - Navigation Buttons -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}" Height="36" Padding="15,8" Margin="0,0,10,0"/>
                <Button Content="Anterior" Command="{Binding PreviousStepCommand}"
                        Style="{StaticResource SecondaryButton}" Height="36" Padding="15,8" Margin="0,0,10,0"
                        IsEnabled="{Binding CurrentStep, Converter={StaticResource IntToHasPreviousStepConverter}}"/>
                <Button Content="{Binding CurrentStep, Converter={StaticResource IntToNextOrFinishTextConverter}}"
                        Command="{Binding NextStepCommand}"
                        Style="{StaticResource PrimaryButton}" Height="36" Padding="25,8" Margin="0,0,10,0"
                        IsEnabled="{Binding CurrentStep, Converter={StaticResource CanMoveToNextStepConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
