<Window x:Class="PautaDinamicaApp.Views.TimeSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Hora Predeterminada" Height="250" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#12151c" Foreground="#e1e1e1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configurar Hora Inicial" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#007bff"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ComboBox x:Name="HourCombo" Width="60" Height="40" FontSize="18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <TextBlock Text=":" FontSize="24" Margin="10,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="MinuteCombo" Width="60" Height="40" FontSize="18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <ComboBox x:Name="AmPmCombo" Width="70" Height="40" FontSize="18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                <ComboBoxItem Content="AM"/>
                <ComboBoxItem Content="PM"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <Button Content="🕒 USAR HORA ACTUAL (DINÁMICO)" Click="NowButton_Click" Height="35" Margin="0,0,0,8" 
                    Background="#6f42c1" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="LIMPIAR" Click="ClearButton_Click" Height="35" Margin="0,0,5,0"
                        Background="#dc3545" Foreground="White" BorderThickness="0"/>
                <Button Grid.Column="1" Content="ACEPTAR" Click="OkButton_Click" Height="35" Margin="5,0,0,0"
                        Background="#28a745" Foreground="White" BorderThickness="0"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
