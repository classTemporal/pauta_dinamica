<Window x:Class="PautaDinamicaApp.Views.TimeSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Hora Predeterminada" Height="280" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configurar Hora Inicial" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ComboBox x:Name="HourCombo" Width="100" Height="50" FontSize="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <TextBlock Text=":" FontSize="24" Margin="15,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontWeight="Bold"/>
            <ComboBox x:Name="MinuteCombo" Width="100" Height="50" FontSize="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <ComboBox x:Name="AmPmCombo" Width="110" Height="50" FontSize="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="15,0,0,0" Visibility="Collapsed">
                <ComboBoxItem Content="AM"/>
                <ComboBoxItem Content="PM"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <Button Content="🕒 USAR HORA ACTUAL (DINÁMICO)" Click="NowButton_Click" Height="40" Margin="0,0,0,8" 
                    Style="{StaticResource SecondaryButton}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="LIMPIAR" Click="ClearButton_Click" Height="40" Margin="0,0,5,0"
                        Style="{StaticResource DangerButton}"/>
                <Button Grid.Column="1" Content="CANCELAR" Click="CancelButton_Click" Height="40" Margin="5,0,5,0"
                        Style="{StaticResource DangerButton}"/>
                <Button Grid.Column="2" Content="ACEPTAR" Click="OkButton_Click" Height="40" Margin="5,0,0,0"
                        Style="{StaticResource SuccessButton}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
