<Window x:Class="PautaDinamicaApp.Views.DateSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Fecha Predeterminada" Height="400" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#12151c" Foreground="#e1e1e1">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configurar Fecha Inicial" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#007bff"/>

        <Viewbox Grid.Row="1">
            <Calendar x:Name="MainCalendar" Background="#1e222d" BorderBrush="#3d4456"/>
        </Viewbox>

        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <Button Content="✨ USAR FECHA DE 'HOY' (DINÁMICO)" Click="TodayButton_Click" Height="35" Margin="0,0,0,8" 
                    Background="#6f42c1" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="LIMPIAR" Click="ClearButton_Click" Height="35" Margin="0,0,5,0"
                        Background="#dc3545" Foreground="White" BorderThickness="0"/>
                <Button Grid.Column="1" Content="ACEPTAR" Click="OkButton_Click" Height="35" Margin="5,0,0,0"
                        Background="#28a745" Foreground="White" BorderThickness="0"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
