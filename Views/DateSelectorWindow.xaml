<Window x:Class="PautaDinamicaApp.Views.DateSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Seleccionar Fecha Predeterminada" Height="480" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    
    <Window.Resources>
        <!-- Estilo base para el Calendario (MODO CLARO PERMANENTE) -->
        <Style TargetType="{x:Type Calendar}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Resources>
                <!-- Estilo para los botones de los días -->
                <Style TargetType="{x:Type primitives:CalendarDayButton}">
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="#AAAAAA"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F0F0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Estilo para los nombres de los días (D L M M J V S) -->
                <Style TargetType="{x:Type primitives:CalendarItem}">
                    <Setter Property="Foreground" Value="#333333"/>
                </Style>

                <!-- Estilo para los botones de Mes y Año -->
                <Style TargetType="{x:Type primitives:CalendarButton}">
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Style.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="#AAAAAA"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configurar Fecha Inicial" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" 
                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>

        <Viewbox Grid.Row="1">
            <Calendar x:Name="MainCalendar" Background="White" PreviewMouseUp="MainCalendar_PreviewMouseUp"/>
        </Viewbox>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="LIMPIAR" Click="ClearButton_Click" Height="45" Margin="0,0,5,0"
                        Style="{DynamicResource DangerButton}"/>
                <Button Grid.Column="1" Content="✨ USAR FECHA DE 'HOY' (DINÁMICO)" Click="TodayButton_Click" Height="45" Margin="5,0,0,0"
                        Style="{DynamicResource SecondaryButton}"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="CANCELAR" Click="CancelButton_Click" Height="45" Margin="0,0,5,0"
                        Style="{DynamicResource DangerButton}"/>
                <Button Grid.Column="1" Content="ACEPTAR" Click="OkButton_Click" Height="45" Margin="5,0,0,0"
                        Style="{DynamicResource SuccessButton}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
