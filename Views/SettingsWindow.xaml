<Window x:Class="PautaDinamicaApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PautaDinamicaApp.Views"
        xmlns:models="clr-namespace:PautaDinamicaApp.Models"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        mc:Ignorable="d"
        Title="Configuración General" Height="650" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisCustom"/>
        <conv:NotNullToBooleanConverter x:Key="NotNullToBool"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Background="Transparent" BorderThickness="0" Margin="10">
            <!-- Global styles for TabControl and TabItem from Styles.xaml will be used implicitly -->

            <!-- TAB RUTAS -->
            <TabItem Header="Rutas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Padding="15">
                        <StackPanel>
                            <TextBlock Text="Rutas Predeterminadas" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}"/>

                            <TextBlock Text="Carpeta para Exportaciones Excel:" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.ExcelExportPath}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowseExcelPathCommand}" 
                                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Width="45" Height="36"/>
                            </Grid>

                            <TextBlock Text="Carpeta para Respaldos (JSON):" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.JsonBackupPath}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowseJsonPathCommand}" 
                                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Width="45" Height="36"/>
                            </Grid>

                            <TextBlock Text="Carpeta para Reportes PDF:" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.PdfReportPath}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowsePdfPathCommand}" 
                                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Width="45" Height="36"/>
                            </Grid>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,10,0,20"/>

                            <TextBlock Text="Resaltado de Filas (Visual)" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="1. Seleccione una Pauta para ver sus campos:" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Pautas}" 
                                              SelectedItem="{Binding SelectedPauta}"
                                              DisplayMemberPath="Name"
                                              Margin="0,0,0,15" Height="35"/>

                                    <TextBlock Text="2. Si el campo con este Nombre:" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding CurrentPautaFields}" 
                                              SelectedValue="{Binding Settings.ColoringField}"
                                              SelectedValuePath="Label"
                                              DisplayMemberPath="Label"
                                              Margin="0,0,0,15" Height="35"
                                              IsEnabled="{Binding SelectedPauta, Converter={StaticResource NotNullToBool}}"/>

                                    <TextBlock Text="3. Tiene este Valor Exacto:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding Settings.ColoringValue}" Margin="0,0,0,15" ToolTip="Ej: 100%, 0.0%"/>

                                    <TextBlock Text="4. Pintar fila de este color:" Style="{StaticResource LabelStyle}"/>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Settings.ColoringColor}" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Código Hexadecimal"/>
                                        <Button Grid.Column="1" Command="{Binding PickColorCommand}" Background="Transparent" Padding="0" BorderThickness="0" Height="36">
                                            <Border Width="60" Height="32" CornerRadius="4" BorderThickness="1" BorderBrush="White">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Settings.ColoringColor, FallbackValue=#28a745}"/>
                                                </Border.Background>
                                            </Border>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Tip: Haga clic en el cuadro de color para abrir el selector visual." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>



            <!-- TAB CORREO -->
            <TabItem Header="📧 Configuración de Correo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Padding="15">
                        <StackPanel>
                            <TextBlock Text="Configurar Envío por Pauta" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}"/>
                            
                            <!-- Selector de Pauta -->
                            <TextBlock Text="1. Seleccione la Pauta a Configurar:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Pautas}" 
                                      SelectedItem="{Binding SelectedPauta}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,20" Height="40">
                            </ComboBox>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPauta, Converter={StaticResource NotNullToBool}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="{Binding SelectedPauta.Name, StringFormat='2. Configuración para: {0}'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15"/>

                                <TextBlock Text="Método de Envío:" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding EmailMethods}" 
                                          SelectedItem="{Binding SelectedPauta.EmailMethod}"
                                          Margin="0,0,0,15" Height="35"/>

                                <!-- Detección Automática Compacta -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Detección Automática de Destinatario" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                            <CheckBox IsChecked="{Binding SelectedPauta.UseAutomatedRecipient}" Content="Activar" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Asocia nombres de agentes con sus correos electrónicos automáticamente." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,10"/>
                                        
                                        <Button Content="⚙️ CONFIGURAR DIRECTORIO Y CAMPO" 
                                                Command="{Binding OpenEmailDirectoryCommand}"
                                                Style="{StaticResource GhostButton}" 
                                                Height="35"
                                                IsEnabled="{Binding SelectedPauta.UseAutomatedRecipient}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Para (To) [Manual o Fallback]:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding SelectedPauta.EmailToTemplate}" Margin="0,0,0,10"/>

                                <TextBlock Text="Con Copia (CC):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding SelectedPauta.EmailCcTemplate}" Margin="0,0,0,10"/>

                                <TextBlock Text="Asunto del Correo:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding SelectedPauta.EmailSubjectTemplate}" Margin="0,0,0,10"/>

                                <TextBlock Text="Cuerpo del Correo:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding SelectedPauta.EmailBodyTemplate}" Margin="0,0,0,15" 
                                         AcceptsReturn="True" Height="100" VerticalContentAlignment="Top" TextWrapping="Wrap"/>

                                <!-- Reglas de Envío (Movidas desde ConfigWindow) -->
                                <TextBlock Text="Reglas de Envío (Exclusión)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,10"/>
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="No enviar correo si el campo..." Style="{StaticResource LabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding CurrentPautaFields}" 
                                                  SelectedValue="{Binding SelectedPauta.ExcludeByFieldId}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Label"
                                                  Margin="0,0,0,10" Height="35"/>
                                        
                                        <TextBlock Text="...tiene exactamente este valor:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding SelectedPauta.ExcludeByFieldValue}" Margin="0,0,0,5"/>
                                        <TextBlock Text="Ejemplo: Excluir si 'Calificación' tiene el valor '100%'" 
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource CardBackgroundBrush}" Padding="10" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="💡 Tip sobre Placeholders:" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/>
                                        <TextBlock Text="Puedes usar [Nombre del Campo] para insertar datos del registro automáticamente." 
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Ejemplo: [Nombre del Agente], [Ticket], [Calificación]" 
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="No hay pautas disponibles para configurar." 
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPauta, Converter={StaticResource NotNullToBool}}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <!-- TAB PLANTILLAS -->
            <TabItem Header="📑 Plantillas">
                <Border Padding="20">
                    <StackPanel>
                        <TextBlock Text="Gestión de Plantillas" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Configura textos reutilizables para facilitar el llenado de comentarios y reportes." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,25" TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="25" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Acceso al Gestor de Plantillas" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="Haz clic en el botón de abajo para abrir la ventana donde podrás agregar, editar e importar tus plantillas de texto." 
                                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                                <Button Content="📂 ABRIR GESTIÓN DE PLANTILLAS" 
                                        Command="{Binding OpenTemplateManagementCommand}"
                                        Style="{StaticResource PrimaryButton}" 
                                        Height="50" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB ADMIN -->
            <TabItem Header="🔐 Opción Administrativa">
                <Border Padding="20">
                    <StackPanel>
                        <TextBlock Text="Opciones Administrativas" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Estas opciones requieren autorización de administrador para ser modificadas." Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20" TextWrapping="Wrap" Opacity="0.8"/>

                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <!-- Vista Bloqueada -->
                                <StackPanel Visibility="{Binding IsAdminSettingsUnlocked, Converter={StaticResource BoolToVisCustom}, ConverterParameter=Inverse}">
                                    <Viewbox Height="40" Margin="0,0,0,20">
                                        <TextBlock Text="AUTORIZACIÓN REQUERIDA" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Viewbox>
                                    
                                    <TextBlock Text="Ingrese la clave maestra de administrador:" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                                    
                                    <PasswordBox x:Name="AdminPassBox" Height="45" Width="300" 
                                                 Style="{StaticResource {x:Type PasswordBox}}"
                                                 Background="{DynamicResource InputBackground}" 
                                                 Foreground="{DynamicResource TextBrush}" 
                                                 Padding="15,0" VerticalContentAlignment="Center"
                                                 FontSize="16" HorizontalAlignment="Center"/>
                                    
                                    <Button Content="VERIFICAR ACCESO" Command="{Binding UnlockAdminSettingsCommand}" 
                                            Style="{StaticResource PrimaryButton}" Height="50" Width="220" Margin="0,30,0,0"
                                            FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Vista Desbloqueada -->
                                <StackPanel Visibility="{Binding IsAdminSettingsUnlocked, Converter={StaticResource BoolToVisCustom}}">
                                    <Border Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,25">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="✓" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" FontSize="18"/>
                                            <TextBlock Text="Acceso Administrativo Concedido" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <TextBlock Text="Configuración de Tiempo Interno" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15"/>
                                    
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,15">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding EnableInternalTimer}" 
                                                      Content="Activar contador de tiempo de auditoría (Silencioso)" 
                                                      FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                                            
                                            <TextBlock Text="Al activar esta opción, el sistema registrará los minutos transcurridos entre cada ticket guardado. Este dato se incluirá automáticamente como la primera columna en las exportaciones a Excel." 
                                                       FontSize="12" Foreground="{DynamicResource TextBrush}" Opacity="0.7" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Padding="30,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,15,0" Width="120" Height="45"/>
                <Button Content="💾 Guardar cambios" Command="{Binding SaveCommand}" Style="{StaticResource SuccessButton}" Width="190" Height="45" FontSize="15"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
