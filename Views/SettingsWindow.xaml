<Window x:Class="PautaDinamicaApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PautaDinamicaApp.Views"
        xmlns:models="clr-namespace:PautaDinamicaApp.Models"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        mc:Ignorable="d"
        Title="Configuración General" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" 
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        MinWidth="600" MinHeight="500"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <conv:FieldTypeDisplayNameConverter x:Key="FieldTypeDisplayNameConverter"/>
        <conv:DictConverter x:Key="DictConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisCustom"/>
        <conv:FieldIdsToNamesConverter x:Key="FieldIdsToNamesConverter"/>
        <conv:NotNullToBooleanConverter x:Key="NotNullToBool"/>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Background="Transparent" BorderThickness="0" Margin="10">
            <!-- TAB GENERAL: Interfaz y Ortografía -->
            <TabItem Header="✨ General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Padding="20">
                        <StackPanel>
                            <TextBlock Text="Personalización y Escritura" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}"/>
                            
                            <!-- Tema Visual -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Tema de la Aplicación:" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="Cambie entre modo claro y oscuro para mejorar la visibilidad." 
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                    <ComboBox ItemsSource="{Binding Themes}" 
                                              SelectedItem="{Binding SelectedTheme}"
                                              Height="35" Width="150" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- Color del Tema (Tinte/Accent) -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Color del Tinte:" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="Personalice el color principal de la interfaz (botones, enlaces, resaltados)." 
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                    <ComboBox ItemsSource="{Binding AccentColors}" 
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedAccentColorName, Mode=TwoWay}"
                                              DisplayMemberPath="Key"
                                              Height="35" Width="150" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Color personalizado:" Style="{StaticResource LabelStyle}" Margin="0,15,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button Command="{Binding PickAccentColorCommand}" 
                                                Style="{StaticResource GhostButton}" Height="36" Padding="8,2" FontSize="11" ToolTip="Seleccionar color personalizado">
                                            <UniformGrid Columns="2">
                                                <Border Width="20" Height="20" CornerRadius="4"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding Settings.AccentColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="..." Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </UniformGrid>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Ortografía -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Corrector Ortográfico:" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="Seleccione el idioma para la revisión en tiempo real." 
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                    <ComboBox ItemsSource="{Binding SpellCheckLanguages}" 
                                              SelectedValue="{Binding SpellCheckLanguage}"
                                              SelectedValuePath="Key"
                                              DisplayMemberPath="Value"
                                              Height="35" Width="200" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Nota: Requiere el paquete de idioma de Windows." 
                                               FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="💡 Estos ajustes se aplican a toda la aplicación de forma global." 
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic" Margin="5,20,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB RUTAS: Almacenamiento -->
            <TabItem Header="📂 Rutas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Padding="20">
                        <StackPanel>
                            <TextBlock Text="Ubicación de Archivos" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}"/>
                            
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Exportaciones Excel:" Style="{StaticResource LabelStyle}"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Settings.ExcelExportPath}" IsReadOnly="True" Height="36" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="..." Command="{Binding BrowseExcelPathCommand}" 
                                                Style="{StaticResource GhostButton}" Margin="8,0,0,0" Width="45" Height="36"/>
                                    </Grid>

                                    <TextBlock Text="Respaldos (JSON):" Style="{StaticResource LabelStyle}"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Settings.JsonBackupPath}" IsReadOnly="True" Height="36" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="..." Command="{Binding BrowseJsonPathCommand}" 
                                                Style="{StaticResource GhostButton}" Margin="8,0,0,0" Width="45" Height="36"/>
                                    </Grid>

                                    <TextBlock Text="Reportes PDF:" Style="{StaticResource LabelStyle}"/>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Settings.PdfReportPath}" IsReadOnly="True" Height="36" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="..." Command="{Binding BrowsePdfPathCommand}" 
                                                Style="{StaticResource GhostButton}" Margin="8,0,0,0" Width="45" Height="36"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB PAUTAS: Visualización y Estadísticas -->
            <TabItem Header="📊 Pautas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Padding="20">
                        <StackPanel>
                            <TextBlock Text="Personalización de Datos" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}"/>
                            
                            <TextBlock Text="Seleccione una Pauta:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Pautas}" 
                                      SelectedItem="{Binding SelectedPauta}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,20" Height="40" Background="{DynamicResource InputBackground}"/>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,25"/>

                            <!-- Resaltado de Filas -->
                            <TextBlock Text="Resaltado Visual de Registros" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="Permite resaltar automáticamente las filas en la tabla principal cuando un campo específico coincide con el valor definido." 
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>
                            
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,25">
                                <StackPanel>
                                    <TextBlock Text="Si el campo:" Style="{StaticResource LabelStyle}" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding CurrentPautaFields}" 
                                              SelectedValue="{Binding SelectedPauta.ColoringField}"
                                              SelectedValuePath="Label" DisplayMemberPath="Label"
                                              Margin="0,0,0,15" Height="35"
                                              IsEnabled="{Binding SelectedPauta, Converter={StaticResource NotNullToBool}}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,15,0">
                                            <TextBlock Text="Tiene el valor:" Style="{StaticResource LabelStyle}" FontSize="12"/>
                                            <TextBox Text="{Binding SelectedPauta.ColoringValue}" Height="35" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Color:" Style="{StaticResource LabelStyle}" FontSize="12"/>
                                            <Button Command="{Binding PickColorCommand}" Background="Transparent" Padding="0" BorderThickness="0" Height="35">
                                                <Border Width="80" Height="32" CornerRadius="4" BorderThickness="1" BorderBrush="White">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding SelectedPauta.ColoringColor, FallbackValue=#28a745}"/>
                                                    </Border.Background>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Contadores -->
                            <TextBlock Text="Contadores y Estadísticas (KPIs)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,5"/>
                            <TextBlock Text="Defina hasta 3 contadores que aparecerán en la barra superior. Contarán cuántas veces aparece un valor específico en el campo seleccionado." 
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>
                            
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Column="0" Grid.Row="0" ItemsSource="{Binding CurrentPautaFields}" 
                                                  SelectedValue="{Binding SelectedPauta.CounterField1}"
                                                  SelectedValuePath="Label" DisplayMemberPath="Label"
                                                  Height="35" Margin="0,0,0,10" IsEnabled="{Binding SelectedPauta, Converter={StaticResource NotNullToBool}}"/>
                                        <TextBox Grid.Column="2" Grid.Row="0" Text="{Binding SelectedPauta.CounterValue1}" 
                                                 Height="35" Margin="0,0,0,10" VerticalContentAlignment="Center" Opacity="0.8"/>

                                        <ComboBox Grid.Column="0" Grid.Row="1" ItemsSource="{Binding CurrentPautaFields}" 
                                                  SelectedValue="{Binding SelectedPauta.CounterField2}"
                                                  SelectedValuePath="Label" DisplayMemberPath="Label"
                                                  Height="35" Margin="0,0,0,10" IsEnabled="{Binding SelectedPauta, Converter={StaticResource NotNullToBool}}"/>
                                        <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding SelectedPauta.CounterValue2}" 
                                                 Height="35" Margin="0,0,0,10" VerticalContentAlignment="Center" Opacity="0.8"/>

                                        <ComboBox Grid.Column="0" Grid.Row="2" ItemsSource="{Binding CurrentPautaFields}" 
                                                  SelectedValue="{Binding SelectedPauta.CounterField3}"
                                                  SelectedValuePath="Label" DisplayMemberPath="Label"
                                                  Height="35" IsEnabled="{Binding SelectedPauta, Converter={StaticResource NotNullToBool}}"/>
                                        <TextBox Grid.Column="2" Grid.Row="2" Text="{Binding SelectedPauta.CounterValue3}" 
                                                 Height="35" VerticalContentAlignment="Center" Opacity="0.8"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB CORREO -->
            <TabItem Header="📧 Correo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Padding="20">
                        <StackPanel>
                            <TextBlock Text="Configuración de Envío" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}"/>
                            
                            <TextBlock Text="Seleccione la Pauta:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Pautas}" 
                                      SelectedItem="{Binding SelectedPauta}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,20" Height="40"/>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>

                            <StackPanel Visibility="{Binding SelectedPauta, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel>
                                        <TextBlock Text="Método:" Style="{StaticResource LabelStyle}" FontSize="12"/>
                                        <ComboBox ItemsSource="{Binding EmailMethods}" 
                                                  SelectedItem="{Binding SelectedPauta.EmailMethod}"
                                                  Height="35"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <CheckBox IsChecked="{Binding SelectedPauta.UseAutomatedRecipient}" VerticalAlignment="Center" x:Name="AutoRecipientCheck"/>
                                                <TextBlock Text="Detección Automática" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                            <Button Content="⚙️ DIRECTORIO DE CORREOS" 
                                                    Command="{Binding OpenEmailDirectoryCommand}"
                                                    Style="{StaticResource GhostButton}" Height="35" FontSize="11"
                                                    IsEnabled="{Binding ElementName=AutoRecipientCheck, Path=IsChecked}"/>
                                            <TextBlock Text="Asocia nombres con correos automáticamente." 
                                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0" Opacity="0.8"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Advertencias Dinámicas de Envío -->
                                <StackPanel Margin="0,0,0,20">
                                    <!-- Advertencia MAILTO -->
                                    <Border Background="#20FFC107" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPauta.EmailMethod}" Value="{x:Static models:EmailMethod.Mailto}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12">
                                                <Run FontWeight="Bold" Foreground="#FFC107">Nota sobre MAILTO:</Run>
                                                <LineBreak/>
                                                <Run Foreground="{DynamicResource TextBrush}">El método MAILTO tiene un límite de caracteres impuesto por Windows. Si el cuerpo del correo es muy largo, es posible que la ventana de correo no se abra o falte información. Para correos extensos, se recomienda usar el método Outlook.</Run>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- Advertencia OUTLOOK -->
                                    <Border Background="#200078D4" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPauta.EmailMethod}" Value="{x:Static models:EmailMethod.Outlook}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="ℹ️" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12">
                                                <Run FontWeight="Bold" Foreground="#0078D4">Requisito de Outlook:</Run>
                                                <LineBreak/>
                                                <Run Foreground="{DynamicResource TextBrush}">Este método requiere que la aplicación de escritorio de Microsoft Outlook esté instalada y configurada con una cuenta activa en este equipo.</Run>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Destinatario (To):" Style="{StaticResource LabelStyle}" FontSize="12"/>
                                        <TextBox Text="{Binding SelectedPauta.EmailToTemplate}" Height="35" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Copia (CC):" Style="{StaticResource LabelStyle}" FontSize="12"/>
                                        <TextBox Text="{Binding SelectedPauta.EmailCcTemplate}" Height="35" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Asunto:" Style="{StaticResource LabelStyle}" FontSize="12"/>
                                <TextBox Text="{Binding SelectedPauta.EmailSubjectTemplate}" Margin="0,0,0,10" Height="35" VerticalContentAlignment="Center"/>

                                <TextBlock Text="Cuerpo:" Style="{StaticResource LabelStyle}" FontSize="12"/>
                                <Grid Margin="0,0,0,20">
                                    <TextBox x:Name="EmailBodyTextBox" 
                                             Text="{Binding SelectedPauta.EmailBodyTemplate}" 
                                             AcceptsReturn="True" Height="200" MinHeight="150" 
                                             VerticalContentAlignment="Top" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             SpellCheck.IsEnabled="{Binding SpellCheckLanguage, Converter={StaticResource NotNullToBooleanConverter}}"
                                             Language="{Binding SpellCheckLanguage, Converter={StaticResource StringToLanguageConverter}, ConverterCulture='es-ES'}"/>
                                    <Thumb Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="EmailBody_DragDelta">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Path Data="M10,0 L10,10 L0,10 Z" Fill="{DynamicResource AccentBrush}" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,20"/>

                                <!-- Reglas de Envío (Exclusión) -->
                                <TextBlock Text="Reglas de Envío (Exclusión)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/>
                                <TextBlock Text="Evite enviar correos para registros que coincidan con un valor específico (ej: calificación = 100%)." 
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15"/>

                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="No enviar correo si el campo..." Style="{StaticResource LabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding CurrentPautaFields}" 
                                                  SelectedValue="{Binding SelectedPauta.ExcludeByFieldId}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Label"
                                                  Margin="0,0,0,10" Height="35"/>

                                        <TextBlock Text="...tiene exactamente este valor:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding SelectedPauta.ExcludeByFieldValue}" Margin="0,0,0,5"/>
                                        <TextBlock Text="Ejemplo: Excluir si 'Calificación' tiene el valor '100%'" 
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Reglas de Traducción (Reemplazo Automático)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/>
                                <TextBlock Text="Traduzca valores internos (ej: '1' a 'Excelente') para que el correo sea legible." 
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15"/>

                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <!-- Barra de herramientas reglas correo -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding IsEmailRuleMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <Button Content="+ Nueva Regla" Command="{Binding AddEmailReplacementRuleCommand}" Style="{StaticResource PrimaryButton}" Height="34" Padding="15,0" Margin="0,0,10,0"/>
                                                <Button Content="Selección Múltiple" Command="{Binding ToggleEmailRuleMultiSelectCommand}" Style="{StaticResource SecondaryButton}" Height="34" Padding="15,0"
                                                        Visibility="{Binding SelectedPauta.EmailReplacementRules.Count, Converter={StaticResource DictConverter}, ConverterParameter=0:Collapsed|Default:Visible}"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsEmailRuleMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button Content="Eliminar Seleccionadas" Command="{Binding DeleteSelectedEmailRulesCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,0" Height="34" Padding="15,0"/>
                                                <Button Content="Seleccionar Todo" Command="{Binding SelectAllEmailRulesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Height="34" Padding="15,0"/>
                                                <Button Content="Cancelar" Command="{Binding ToggleEmailRuleMultiSelectCommand}" Style="{StaticResource GhostButton}" Height="34" Padding="15,0"/>
                                             </StackPanel>
                                        </Grid>
                                        
                                        <ListBox x:Name="EmailRulesList" ItemsSource="{Binding SelectedPauta.EmailReplacementRules}" 
                                                 Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 AllowDrop="True"
                                                 PreviewMouseLeftButtonDown="EmailRulesList_PreviewMouseLeftButtonDown"
                                                 PreviewMouseLeftButtonUp="EmailRulesList_PreviewMouseLeftButtonUp"
                                                 MouseMove="EmailRulesList_MouseMove"
                                                 Drop="EmailRulesList_Drop"
                                                 Height="250">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" Padding="12" CornerRadius="8" Margin="0,0,0,8">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="40">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/> <!-- Selection -->
                                                            <ColumnDefinition Width="1.5*"/> <!-- Campos -->
                                                            <ColumnDefinition Width="*"/>    <!-- Si valor es -->
                                                            <ColumnDefinition Width="*"/>    <!-- Reemplazar por -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Action -->
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                                  Visibility="{Binding Data.IsEmailRuleMultiSelectMode, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                  VerticalAlignment="Center" Margin="5,0,12,0"/>

                                                        <Button Grid.Column="1" Command="{Binding Data.EditEmailRuleFieldsCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="8,4" Margin="2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" 
                                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource FieldIdsToNamesConverter}">
                                                                            <Binding Path="TargetFieldIds" />
                                                                            <Binding Path="Data.CurrentPautaFields" Source="{StaticResource Proxy}" />
                                                                            <Binding Path="TargetFieldIds.Count" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="✏️" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.5"/>
                                                            </Grid>
                                                        </Button>

                                                        <TextBox Grid.Column="2" Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Background="Transparent" BorderThickness="0" Padding="8,4" VerticalAlignment="Center" 
                                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>

                                                        <TextBox Grid.Column="3" Text="{Binding ReplacementValue, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Background="Transparent" BorderThickness="0" Padding="8,4" VerticalAlignment="Center" 
                                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>

                                                        <Button Grid.Column="4" Content="🗑️" Command="{Binding Data.RemoveEmailReplacementRuleCommand, Source={StaticResource Proxy}}" 
                                                                CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="0" Width="30" Height="30" VerticalAlignment="Center" Margin="5,0"
                                                                Visibility="{Binding Data.IsEmailRuleMultiSelectMode, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Text="* Pulse 'Editar...' para seleccionar a qué campos se aplica cada regla." 
                                                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" FontStyle="Italic"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB PLANTILLAS -->
            <TabItem Header="📑 Plantillas">
                <Border Padding="30">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="Gestión de Fragmentos de Texto" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Configure textos rápidos para rellenar comentarios con un solo clic." 
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30"/>
                        
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="15" Padding="30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Button Content="📂 ABRIR GESTOR DE PLANTILLAS" 
                                        Command="{Binding OpenTemplateManagementCommand}"
                                        Style="{StaticResource PrimaryButton}" 
                                        Height="60" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB ADMIN -->
            <TabItem Header="🔐 Admin">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50">
                        <StackPanel MaxWidth="500" Width="500">
                            <TextBlock Text="Acceso Administrativo" FontSize="22" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Estas opciones permiten modificar el comportamiento interno del sistema. Por favor, proceda con precaución." 
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" Margin="0,0,0,30" TextWrapping="Wrap"/>

                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="15" Padding="40" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                                </Border.Effect>
                                <Grid>
                                    <!-- Vista Bloqueada: Login Admin -->
                                    <StackPanel Visibility="{Binding IsAdminSettingsUnlocked, Converter={StaticResource BoolToVisCustom}, ConverterParameter=Inverse}" HorizontalAlignment="Center">
                                        <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5A3,3 0 0,1 15,8V10H17V17H7V10H9V8A3,3 0 0,1 12,5M12,7A1,1 0 0,0 11,8V10H13V8A1,1 0 0,0 12,7Z" 
                                              Fill="{DynamicResource AccentBrush}" Width="50" Height="50" Stretch="Uniform" Margin="0,0,0,25" Opacity="0.9"/>
                                        
                                        <TextBlock Text="SISTEMA RESTRINGIDO" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" FontSize="14"/>
                                        <TextBlock Text="Ingrese la clave maestra para continuar" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,25" FontSize="11" HorizontalAlignment="Center"/>
                                        
                                        <PasswordBox x:Name="AdminPassBox" Height="45" Width="300" 
                                                     Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                     Padding="15,0" VerticalContentAlignment="Center" HorizontalAlignment="Center"/>
                                        
                                        <Button Content="DESBLOQUEAR AJUSTES" Command="{Binding UnlockAdminSettingsCommand}" 
                                                Style="{StaticResource PrimaryButton}" Height="50" Width="240" Margin="0,25,0,0" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- Vista Desbloqueada: Ajustes Admin -->
                                    <StackPanel Visibility="{Binding IsAdminSettingsUnlocked, Converter={StaticResource BoolToVisCustom}}">
                                        <Border Background="{DynamicResource SuccessBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,30" Opacity="0.9">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="✓" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" FontSize="18"/>
                                                <TextBlock Text="Acceso de Administrador Activo" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <TextBlock Text="Gestión de Tiempos" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>
                                        
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding EnableInternalTimer}" Style="{StaticResource {x:Type CheckBox}}" VerticalAlignment="Top" Margin="0,3,15,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Habilitar Contador de Auditoría Silencioso" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Cuando esta opción está activa, el sistema registrará automáticamente los minutos transcurridos entre cada registro guardado en la base de datos de auditoría." 
                                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <TextBlock Text="* Estos datos se guardarán junto con cada registro para fines de análisis de productividad." 
                                                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic" Margin="0,15,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB GENERAL: Documentación, Usuario, Cerrar Sesión -->
            <TabItem Header="🔧 General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Padding="20">
                        <StackPanel>
                            <!-- Documentación -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="📘 Documentación y Guía del Sistema" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Consulta la guía completa del sistema: uso de pautas, registro de datos, exportación, correo electrónico y más." 
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>
                                    <Button Content="Abrir Documentación" Command="{Binding OpenHelpCommand}" 
                                            Style="{StaticResource PrimaryButton}" Height="40" Width="200" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- Usuario actual -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="👤 Usuario Actual" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Sesión activa:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding CurrentUser.Username}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15"/>
                                    <Button Content="🔄 Cambiar Usuario" Command="{Binding SwitchUserCommand}" 
                                            Style="{StaticResource SecondaryButton}" Height="40" Width="180" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- Cerrar Sesión -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="🚪 Cerrar Sesión" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Cierra la sesión actual y regresa a la pantalla de login." 
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>
                                    <Button Content="CERRAR SESIÓN" Command="{Binding LogoutCommand}" 
                                            Style="{StaticResource DangerButton}" Height="40" Width="180" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Padding="30,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCELAR" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}" Margin="0,0,15,0" Width="120" Height="45"/>
                <Button Content="APLICAR" Command="{Binding ApplyCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,15,0" Width="120" Height="45"/>
                <Button Content="💾 Guardar cambios" Command="{Binding SaveCommand}" Style="{StaticResource SuccessButton}" Width="190" Height="45" FontSize="15"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
