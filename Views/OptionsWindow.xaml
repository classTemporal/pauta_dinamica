<Window x:Class="PautaDinamicaApp.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        Title="Gestor de Configuraciones" Height="650" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    
    <Window.Resources>
        <ResourceDictionary>
            <conv:FieldTypeDisplayNameConverter x:Key="FieldTypeDisplayNameConverter"/>
            <conv:CalculationRoundingDisplayNameConverter x:Key="RoundingConverter"/>
            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Inverse="True" />
            
            <CollectionViewSource x:Key="GroupedExtensions" Source="{Binding AvailableExtensions}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Category"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <Style x:Key="ModernListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#15FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Configuración Avanzada del Campo" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Editando:" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="8,2" Margin="10,0">
                        <TextBlock Text="{Binding OriginalField.Label}" FontSize="13" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Tipo:" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OriginalField.Type, Converter={StaticResource FieldTypeDisplayNameConverter}}" FontSize="13" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Contenido segun el tipo -->
        <Grid Grid.Row="1">
            
            <!-- VISTA A: LISTADO (DROPDOWN) -->
            <Grid Visibility="{Binding OriginalField.Type, Converter={StaticResource DictConverter}, ConverterParameter='Dropdown:Visible|Default:Collapsed'}">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- TAB 1: OPCIONES -->
                    <TabItem Header="Lista de Elementos">
                        <DockPanel Margin="0,10,0,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                                <TextBlock Text="ELEMENTOS DE LA LISTA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                    <Button Content="Importar" Command="{Binding ImportOptionsCommand}" Style="{StaticResource GhostButton}" Padding="12,6" FontSize="11" Margin="0,0,8,0"/>
                                    <Button Content="Exportar" Command="{Binding ExportOptionsCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Margin="0,0,8,0"/>
                                    <Button Content="Selección Múltiple" Command="{Binding ToggleMultiSelectCommand}" Style="{StaticResource GhostButton}" Padding="12,6" FontSize="11"/>
                                </StackPanel>
                                 <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="8,4" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2"
                                         Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                          <Button Content="▲ Mover" Command="{Binding MoveUpCommand}" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Padding="10,0" Height="30" FontSize="11" ToolTip="Subir seleccionados"/>
                                          <Button Content="▼ Mover" Command="{Binding MoveDownCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="10,0" Height="30" FontSize="11" ToolTip="Bajar seleccionados"/>
                                          <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,2,8,2" Background="{DynamicResource BorderBrush}"/>
                                          <Button Content="Seleccionar Todo" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,0" Height="30" FontSize="11"/>
                                          <Button Content="Borrar Selección" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Padding="12,0" Height="30" FontSize="11"/>
                                          <Button Content="Cerrar" Command="{Binding ToggleMultiSelectCommand}" Style="{StaticResource GhostButton}" Padding="10,0" Height="30" FontSize="11"/>
                                     </StackPanel>
                                 </Border>
                            </Grid>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                                <TextBlock Text="Añadir nueva opción a la lista:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewOptionText, UpdateSourceTrigger=PropertyChanged}" Height="40" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="AGREGAR" Command="{Binding AddOptionCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="20,0"/>
                                </Grid>
                            </StackPanel>
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <ListBox x:Name="OptionsList" ItemsSource="{Binding Options}" 
                                     Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MaxHeight="350"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="OptionsList_PreviewMouseLeftButtonDown"
                                     PreviewMouseLeftButtonUp="OptionsList_PreviewMouseLeftButtonUp"
                                     MouseMove="OptionsList_MouseMove"
                                     Drop="OptionsList_Drop">
                                     <ListBox.ItemContainerStyle>
                                         <Style TargetType="ListBoxItem">
                                             <Setter Property="Padding" Value="0"/>
                                             <Setter Property="Background" Value="Transparent"/>
                                             <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                             <Setter Property="Template">
                                                 <Setter.Value>
                                                     <ControlTemplate TargetType="ListBoxItem">
                                                         <Border x:Name="Bd" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" Padding="10,8" CornerRadius="8" Margin="0,0,0,6">
                                                             <ContentPresenter />
                                                         </Border>
                                                         <ControlTemplate.Triggers>
                                                             <Trigger Property="IsMouseOver" Value="True">
                                                                 <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                             </Trigger>
                                                             <Trigger Property="IsSelected" Value="True">
                                                                 <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                 <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                                             </Trigger>
                                                         </ControlTemplate.Triggers>
                                                     </ControlTemplate>
                                                 </Setter.Value>
                                             </Setter>
                                         </Style>
                                     </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                 <CheckBox IsChecked="{Binding IsSelected}" Visibility="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                 <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/>
                                                 <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                     <Button Content="▲" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Width="28" Height="28" FontSize="14" Padding="0" Margin="0,0,4,0" ToolTip="Subir elemento"/>
                                                     <Button Content="▼" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Width="28" Height="28" FontSize="14" Padding="0" Margin="0,0,4,0" ToolTip="Bajar elemento"/>
                                                     <Button Content="✕" Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Width="28" Height="28" FontSize="12" FontWeight="Bold" Padding="0"
                                                             ToolTip="Eliminar permanentemente"/>
                                                 </StackPanel>
                                             </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>
                    </TabItem>

                    <!-- TAB 2: AUTO-SELECCIÓN -->
                    <TabItem Header="Selección Automática">
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Define reglas para que este campo se seleccione solo según otros valores." 
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>
                            
                            <Button DockPanel.Dock="Top" Content="AÑADIR REGLA" Command="{Binding AddAutoSelectRuleCommand}" 
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="15,5" Margin="0,0,0,10"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AutoSelectRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                        <TextBlock Text="Si el campo:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                                        <ComboBox ItemsSource="{Binding DataContext.AvailableFields, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedValue="{Binding SourceFieldId}"
                                                                  SelectedValuePath="Id"
                                                                  DisplayMemberPath="Label"
                                                                  MinHeight="38" Margin="0"/>
                                                    </StackPanel>

                                                    <Button Grid.Row="0" Grid.Column="1" Content="✕" 
                                                            Command="{Binding DataContext.RemoveAutoSelectRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource DangerButton}" 
                                                            VerticalAlignment="Top" Width="32" Height="32" Padding="0" Margin="15,0,0,0"
                                                            FontSize="14" ToolTip="Eliminar regla"/>

                                                    <Grid Grid.Row="1" Grid.ColumnSpan="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="3*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="4*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="Operador:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.Operators, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding Operator}" Height="36"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                            <TextBlock Text="Valor (ej: 1, 63%):" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Bottom" Margin="0,0,10,6" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>

                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="Seleccionar:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.ResultOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding TargetValue}" Height="36"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- VISTA B: REGLAS COMPLEJAS (CALCULATION) -->
            <Grid Visibility="{Binding OriginalField.Type, Converter={StaticResource DictConverter}, ConverterParameter='Calculation:Visible|Default:Collapsed'}">
                <DockPanel>
                    <!-- Alerta de Error de Porcentaje -->
                    <Border DockPanel.Dock="Top" Background="#ff4d4d" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ValidationError}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0" 
                            BorderBrush="#44ff4d4d" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding EnableZeroTrigger}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Anulación Crítica: Poner en 0% si " VerticalAlignment="Center" FontSize="11" Foreground="#ff4d4d" FontWeight="Bold"/>

                            <Grid Grid.Column="2">
                                <ToggleButton x:Name="CalcTriggerToggle" Height="28" Margin="5,0" IsEnabled="{Binding EnableZeroTrigger}" Style="{StaticResource GhostToggleButtonStyle}" FontSize="10">
                                    <TextBlock Text="{Binding TriggerSelectionsSummary}" TextTrimming="CharacterEllipsis"/>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=CalcTriggerToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=CalcTriggerToggle}" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="6" MaxHeight="300" Width="250">
                                        <ListBox ItemsSource="{Binding TriggerFieldChoices}" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Foreground="{DynamicResource TextBrush}" Margin="0,2"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBlock Grid.Column="3" Text=" es igual a " VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox Grid.Column="4" Text="{Binding ZeroTriggerValue, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="100" Margin="5,0,0,0" Padding="5,0" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding EnableZeroTrigger}"/>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="REGLAS DE EVALUACIÓN" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,8"/>
                                <CheckBox IsChecked="{Binding UseCustomWeights}" Content="Activar Porcentajes Personalizados (Distribución sobre 100%)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                <CheckBox IsChecked="{Binding ShowDecimals}" Content="Mostrar decimales en el resultado (ej: 95.0% vs 95%)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Modo de Redondeo:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0"/>
                                    <ComboBox ItemsSource="{Binding AvailableRoundingModes}" SelectedItem="{Binding Rounding}" 
                                              Width="200" Height="28">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource RoundingConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Restablecer todo" Command="{Binding ResetCalculationCommand}" Style="{StaticResource DangerButton}" Padding="10,5" VerticalAlignment="Bottom" FontSize="11"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CalculationRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <CheckBox IsChecked="{Binding IsActive}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FieldLabel}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="13"/>
                                                </CheckBox>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="N/A:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0"/>
                                                    <TextBox Text="{Binding NaValue, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="25" FontSize="10" Padding="5,0" VerticalContentAlignment="Center"/>
                                                    <TextBlock Text="Contribución %:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="11" Margin="10,0,5,0" IsEnabled="{Binding DataContext.UseCustomWeights, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <TextBox Text="{Binding PercentageText, UpdateSourceTrigger=PropertyChanged}" Width="40" Height="25" FontSize="10" Padding="5,0" VerticalContentAlignment="Center" IsEnabled="{Binding DataContext.UseCustomWeights, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Mappings}" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                                                                            <Setter Property="Opacity" Value="0.5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextBrush}" FontSize="11" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text=" → " Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding ScoreText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDisabled, Converter={StaticResource DictConverter}, ConverterParameter='True:False|False:True'}"
                                                                         Width="40" Height="22" FontSize="10" Padding="3,0" VerticalContentAlignment="Center" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- VISTA C: PROMEDIO (AVERAGE) -->
            <Grid Visibility="{Binding OriginalField.Type, Converter={StaticResource DictConverter}, ConverterParameter='Average:Visible|Default:Collapsed'}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SELECCIONAR CÁLCULOS PARA PROMEDIAR" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,10"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding ShowDecimals}" Content="Mostrar decimales" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="11" Margin="0,0,20,0"/>
                            <TextBlock Text="Redondeo:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding AvailableRoundingModes}" SelectedItem="{Binding Rounding}" 
                                      Width="180" Height="28" FontSize="11">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource RoundingConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- BARRA DE ANULACIÓN CRÍTICA -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,15,0,0" 
                            BorderBrush="#44ff4d4d" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding EnableZeroTrigger}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Anulación Crítica: Poner en 0% si " VerticalAlignment="Center" FontSize="11" Foreground="#ff4d4d" FontWeight="Bold"/>

                            <Grid Grid.Column="2">
                                <ToggleButton x:Name="AvgTriggerToggle" Height="28" Margin="5,0" IsEnabled="{Binding EnableZeroTrigger}" Style="{StaticResource GhostToggleButtonStyle}" FontSize="10">
                                    <TextBlock Text="{Binding TriggerSelectionsSummary}" TextTrimming="CharacterEllipsis"/>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=AvgTriggerToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=AvgTriggerToggle}" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="6" MaxHeight="300" Width="250">
                                        <ListBox ItemsSource="{Binding TriggerFieldChoices}" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Foreground="{DynamicResource TextBrush}" Margin="0,2"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBlock Grid.Column="3" Text=" es igual a " VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox Grid.Column="4" Text="{Binding ZeroTriggerValue, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="100" Margin="5,0,0,0" Padding="5,0" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding EnableZeroTrigger}"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15">
                        <ListBox ItemsSource="{Binding AverageTargets}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,8">
                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" FontSize="14"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- VISTA D: FORMATO DE HORA (TIME) -->
            <Grid Visibility="{Binding OriginalField.Type, Converter={StaticResource DictConverter}, ConverterParameter='Time:Visible|Default:Collapsed'}">
                <StackPanel Margin="0,20">
                    <TextBlock Text="CONFIGURACIÓN DE FORMATO DE HORA" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,20"/>
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <RadioButton IsChecked="{Binding TimeFormat, Converter={StaticResource DictConverter}, ConverterParameter='HH:mm:True|Default:False'}" 
                                         GroupName="TimeFormat" Margin="0,0,0,15">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <StackPanel>
                                                    <TextBlock Text="24 Horas" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="Ejemplo: 14:30" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <RadioButton IsChecked="{Binding TimeFormat, Converter={StaticResource DictConverter}, ConverterParameter='hh:mm tt:True|Default:False'}" 
                                         GroupName="TimeFormat">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <StackPanel>
                                                    <TextBlock Text="AM / PM" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="Ejemplo: 02:30 PM" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- VISTA E: LÍMITES DE CARACTERES (TEXT, TEXTAREA, NUMERIC) -->
            <Grid Visibility="{Binding OriginalField.Type, Converter={StaticResource DictConverter}, ConverterParameter='Text:Visible|TextArea:Visible|Numeric:Visible|Default:Collapsed'}">
                <StackPanel Margin="0,20">
                    <TextBlock Text="LÍMITE DE CARACTERES" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,20"/>
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Establece la cantidad máxima de caracteres que el usuario puede ingresar en este campo:" 
                                     Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,15" TextWrapping="Wrap"/>
                            
                            <CheckBox IsChecked="{Binding WarnOnDuplicate}" Content="⚠️ Advertir si el valor está duplicado en otro registro" 
                                      Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15" FontWeight="Bold"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="1" Maximum="4000" Value="{Binding MaxLength}" TickFrequency="50" IsSnapToTickEnabled="True"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0">
                                    <TextBox Text="{Binding MaxLength, UpdateSourceTrigger=PropertyChanged}" Width="60" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                    <TextBlock Text=" caracteres" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            
                            <TextBlock Text="Sugerencias:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,20,0,8"/>
                            <BulletDecorator Margin="0,0,0,5">
                                <TextBlock Text="Texto corto (Nombre, ID): 100 - 255" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                            </BulletDecorator>
                            <BulletDecorator Margin="0,0,0,5">
                                <TextBlock Text="Numérico (RUT, Cantidades): 10 - 20" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                            </BulletDecorator>
                            <BulletDecorator>
                                <TextBlock Text="Área de Texto (Comentarios): 500 - 2000" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                            </BulletDecorator>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- VISTA F: ARCHIVOS ADJUNTOS (FILEATTACHMENT) -->
            <Grid Visibility="{Binding OriginalField.Type, Converter={StaticResource DictConverter}, ConverterParameter='FileAttachment:Visible|Default:Collapsed'}">
                <Grid Margin="0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="Auto"/> <!-- Global Options -->
                        <RowDefinition Height="*"/>    <!-- Format Selection -->
                        <RowDefinition Height="Auto"/> <!-- Footer actions -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CONFIGURACIÓN DE ARCHIVOS ADJUNTOS" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                    
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding AllowMultipleAttachments}" Content="Permitir adjuntar múltiples archivos" 
                                      Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,30,0"/>
                            
                            <CheckBox IsChecked="{Binding AttachToEmail}" Content="Adjuntar automáticamente al enviar correo" 
                                      Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <CheckBox Grid.Row="0" IsChecked="{Binding AllowAnyFile}" Content="Permitir CUALQUIER tipo de archivo (Sin restricciones)" 
                                      Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="1" Text="Formatos específicos:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                            
                            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource BackgroundBrush}"
                                    IsEnabled="{Binding AllowAnyFile, Converter={StaticResource DictConverter}, ConverterParameter='True:False|False:True'}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                                    <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedExtensions}}" BorderThickness="0">
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,15,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                            <Border Grid.Column="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="10,0,0,0" Opacity="0.5" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,15,10" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Extension}" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="5,0,0,0"/>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <Button Grid.Row="3" Content="📂 Abrir Carpeta de Archivos Adjuntos" Command="{Binding OpenFolderCommand}" 
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Height="35" Padding="15,0" FontSize="12" Margin="0,10,0,0"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Pie de Pagina -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Button Content="CANCELAR" IsCancel="True" Height="45" Margin="0,0,10,0" Style="{StaticResource GhostButton}"/>
            <Button Grid.Column="1" Content="LISTO - GUARDAR" Click="OkButton_Click" Height="45" Style="{StaticResource SuccessButton}"
                    IsEnabled="{Binding HasError, Converter={StaticResource DictConverter}, ConverterParameter='True:False|False:True'}"/>
        </Grid>
    </Grid>
</Window>
