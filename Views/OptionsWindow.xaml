<Window x:Class="PautaDinamicaApp.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        Title="Gestor de Configuraciones" Height="650" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#12151c" Foreground="#e1e1e1">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/FieldTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:DictConverter x:Key="DictConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Configuración Avanzada" FontSize="20" FontWeight="Bold" Foreground="White"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Campo: " FontSize="12" Foreground="#94a3b8"/>
                <TextBlock Text="{Binding OriginalField.Label}" FontSize="12" Foreground="#007bff" FontWeight="Bold"/>
                <TextBlock Text=" (" FontSize="12" Foreground="#94a3b8"/>
                <TextBlock Text="{Binding OriginalField.Type}" FontSize="12" Foreground="#94a3b8"/>
                <TextBlock Text=")" FontSize="12" Foreground="#94a3b8"/>
            </StackPanel>
        </StackPanel>

        <!-- Contenido segun el tipo -->
        <Grid Grid.Row="1">
            
            <!-- VISTA A: LISTADO (DROPDOWN) -->
            <Grid Visibility="{Binding OriginalField.Type, Converter={StaticResource DictConverter}, ConverterParameter='Dropdown:Visible|Default:Collapsed'}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                            <Button Content="📊 Exportar" Command="{Binding ExportOptionsCommand}" Style="{StaticResource ExcelButton}" Padding="10,5" FontSize="11" Margin="0,0,5,0"/>
                            <Button Content="☑️ Selección Múltiple" Command="{Binding ToggleMultiSelectCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11"/>
                        </StackPanel>
                        <Border Background="#3d4456" CornerRadius="4" Padding="5" Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="✔️ Todo" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Padding="8,4" FontSize="11"/>
                                <Button Content="🗑️ Borrar" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Margin="0,0,5,0" Padding="8,4" FontSize="11"/>
                                <Button Content="❌ Cancelar" Command="{Binding ToggleMultiSelectCommand}" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11"/>
                            </WrapPanel>
                        </Border>
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                        <TextBlock Text="Agregar Nueva Opción" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewOptionText, UpdateSourceTrigger=PropertyChanged}" Height="40" Background="#262b38" BorderBrush="#3d4456" Padding="12,0" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="AGREGAR" Command="{Binding AddOptionCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="20,0"/>
                        </Grid>
                    </StackPanel>
                    <Border Background="#1e222d" CornerRadius="8" Padding="10" BorderBrush="#2d3446" BorderThickness="1">
                        <ListBox ItemsSource="{Binding Options}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" Visibility="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="White" VerticalAlignment="Center" FontSize="14"/>
                                        <Button Grid.Column="2" Content="ELIMINAR" Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="10"
                                                Visibility="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- VISTA B: REGLAS COMPLEJAS (CALCULATION) -->
            <Grid Visibility="{Binding OriginalField.Type, Converter={StaticResource DictConverter}, ConverterParameter='Calculation:Visible|Default:Collapsed'}">
                <DockPanel>
                    <!-- Alerta de Error de Porcentaje -->
                    <Border DockPanel.Dock="Top" Background="#ff4d4d" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ValidationError}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <Border DockPanel.Dock="Top" Background="#262b38" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="REGLAS DE EVALUACIÓN" FontWeight="Bold" Foreground="#28a745" Margin="0,0,0,8"/>
                            <CheckBox IsChecked="{Binding UseCustomWeights}" Content="Activar Porcentajes Personalizados (Distribución sobre 100%)" Foreground="#94a3b8" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CalculationRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1e222d" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#3d4456" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <CheckBox IsChecked="{Binding IsActive}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FieldLabel}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                </CheckBox>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="N/A:" Foreground="#94a3b8" VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0"/>
                                                    <TextBox Text="{Binding NaValue, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="25" FontSize="10" Padding="5,0" VerticalContentAlignment="Center"/>
                                                    <TextBlock Text="Contribución %:" Foreground="#94a3b8" VerticalAlignment="Center" FontSize="11" Margin="10,0,5,0" IsEnabled="{Binding DataContext.UseCustomWeights, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <TextBox Text="{Binding PercentageText, UpdateSourceTrigger=PropertyChanged}" Width="40" Height="25" FontSize="10" Padding="5,0" VerticalContentAlignment="Center" IsEnabled="{Binding DataContext.UseCustomWeights, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Mappings}" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#2d3446"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                            <Setter Property="Background" Value="#1a1d26"/>
                                                                            <Setter Property="Opacity" Value="0.5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Value}" Foreground="White" FontSize="11" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text=" → " Foreground="#94a3b8" VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding ScoreText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDisabled, Converter={StaticResource DictConverter}, ConverterParameter='True:False|False:True'}"
                                                                         Width="40" Height="22" FontSize="10" Background="#12151c" BorderThickness="0" Padding="3,0" VerticalContentAlignment="Center" Foreground="#007bff" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- VISTA C: PROMEDIO (AVERAGE) -->
            <Grid Visibility="{Binding OriginalField.Type, Converter={StaticResource DictConverter}, ConverterParameter='Average:Visible|Default:Collapsed'}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SELECCIONAR CÁLCULOS PARA PROMEDIAR" FontWeight="Bold" Foreground="#6f42c1" Margin="0,0,0,15"/>
                    <Border Background="#1e222d" CornerRadius="8" Padding="15">
                        <ListBox ItemsSource="{Binding AverageTargets}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,8">
                                        <TextBlock Text="{Binding Text}" Foreground="White" FontSize="14"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- VISTA D: FORMATO DE HORA (TIME) -->
            <Grid Visibility="{Binding OriginalField.Type, Converter={StaticResource DictConverter}, ConverterParameter='Time:Visible|Default:Collapsed'}">
                <StackPanel Margin="0,20">
                    <TextBlock Text="CONFIGURACIÓN DE FORMATO DE HORA" FontWeight="Bold" Foreground="#007bff" Margin="0,0,0,20"/>
                    <Border Background="#1e222d" CornerRadius="8" Padding="20" BorderBrush="#2d3446" BorderThickness="1">
                        <StackPanel>
                            <RadioButton IsChecked="{Binding TimeFormat, Converter={StaticResource DictConverter}, ConverterParameter='HH:mm:True|Default:False'}" 
                                         GroupName="TimeFormat" Margin="0,0,0,15">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <StackPanel>
                                                    <TextBlock Text="24 Horas" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="Ejemplo: 14:30" Foreground="#94a3b8" FontSize="12"/>
                                                </StackPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <RadioButton IsChecked="{Binding TimeFormat, Converter={StaticResource DictConverter}, ConverterParameter='hh:mm tt:True|Default:False'}" 
                                         GroupName="TimeFormat">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <StackPanel>
                                                    <TextBlock Text="AM / PM" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="Ejemplo: 02:30 PM" Foreground="#94a3b8" FontSize="12"/>
                                                </StackPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Pie de Pagina -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Button Content="CANCELAR" IsCancel="True" Height="45" Margin="0,0,10,0" Style="{StaticResource GhostButton}"/>
            <Button Grid.Column="1" Content="LISTO - GUARDAR" Click="OkButton_Click" Height="45" Style="{StaticResource SuccessButton}"
                    IsEnabled="{Binding HasError, Converter={StaticResource DictConverter}, ConverterParameter='True:False|False:True'}"/>
        </Grid>
    </Grid>
</Window>
