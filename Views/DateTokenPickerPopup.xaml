<Window x:Class="PautaDinamicaApp.Views.DateTokenPickerPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar fecha dinámica" Height="560" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <!--
        Selector de tokens de fecha dinámica: [Hoy], [Semana], [Mes], [Año], [Rango].
        El marcador se recalcula con la fecha del sistema cada vez que se envía el correo.
    -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Insertar fecha dinámica" FontSize="19" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="El marcador se sustituye por la fecha real al enviar el correo, usando la configuración de abajo."/>

        <!-- Tokens simples -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
            <Button Content="[Hoy]" Height="38" Margin="2" Tag="Hoy"
                    Style="{DynamicResource SecondaryButton}" Click="SimpleToken_Click"/>
            <Button Content="[Semana]" Height="38" Margin="2" Tag="Semana"
                    Style="{DynamicResource SecondaryButton}" Click="SimpleToken_Click"/>
            <Button Content="[Mes]" Height="38" Margin="2" Tag="Mes"
                    Style="{DynamicResource SecondaryButton}" Click="SimpleToken_Click"/>
            <Button Content="[Año]" Height="38" Margin="2" Tag="Año"
                    Style="{DynamicResource SecondaryButton}" Click="SimpleToken_Click"/>
        </UniformGrid>

        <!-- Configuración del rango -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14">
            <StackPanel>
                <TextBlock Text="Rango personalizado  [Rango]" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                <TextBlock Text="Modo de cálculo" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                <ComboBox x:Name="ModeCombo" Height="30" Margin="0,0,0,10" SelectionChanged="Config_Changed">
                    <ComboBoxItem Content="Últimos N días (termina hoy)" Tag="Week"/>
                    <ComboBoxItem Content="Entre dos fechas fijas" Tag="Fixed"/>
                    <ComboBoxItem Content="Entre dos días de la semana" Tag="Weekday"/>
                </ComboBox>

                <StackPanel x:Name="WeekPanel">
                    <TextBlock Text="Cantidad de días" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                    <TextBox x:Name="DaysBox" Height="30" VerticalContentAlignment="Center"
                             Text="7" TextChanged="Config_Changed"/>
                </StackPanel>

                <StackPanel x:Name="FixedPanel" Visibility="Collapsed">
                    <TextBlock Text="Desde" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                    <DatePicker x:Name="FromDate" Height="30" Margin="0,0,0,8" SelectedDateChanged="Config_Changed"/>
                    <TextBlock Text="Hasta" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                    <DatePicker x:Name="ToDate" Height="30" SelectedDateChanged="Config_Changed"/>
                </StackPanel>

                <StackPanel x:Name="WeekdayPanel" Visibility="Collapsed">
                    <TextBlock Text="Desde el día" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FromDayCombo" Height="30" Margin="0,0,0,8" SelectionChanged="Config_Changed"/>
                    <TextBlock Text="Hasta el día" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ToDayCombo" Height="30" SelectionChanged="Config_Changed"/>
                </StackPanel>

                <TextBlock Text="Formato de salida" FontSize="11" Opacity="0.7" Margin="0,10,0,4"/>
                <ComboBox x:Name="FormatCombo" Height="30" SelectionChanged="Config_Changed">
                    <ComboBoxItem Content="03/10/2026 al 09/10/2026" Tag="RangeWithAl"/>
                    <ComboBoxItem Content="03/10/2026 - 09/10/2026" Tag="RangeWithDash"/>
                    <ComboBoxItem Content="Solo la fecha final" Tag="EndOnly"/>
                    <ComboBoxItem Content="3 de octubre de 2026" Tag="EndLong"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Vista previa -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Vista previa" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                           Text="—"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancelar" Height="42" Margin="0,0,5,0" IsCancel="True"
                    Style="{DynamicResource DangerButton}"/>
            <Button Grid.Column="1" Content="Insertar [Rango]" Height="42" Margin="5,0,0,0" IsDefault="True"
                    Style="{DynamicResource SuccessButton}" Click="InsertRange_Click"/>
        </Grid>
    </Grid>
</Window>
