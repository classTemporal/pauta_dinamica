<Window x:Class="PautaDinamicaApp.Views.DateTokenPickerPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar fecha dinámica" Width="480"
        SizeToContent="Height" MinHeight="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <!--
        Selector de tokens de fecha dinámica: [Hoy], [Semana], [Mes], [Año], [Rango].
        Los simples se seleccionan y luego se pulsa Insertar. El rango vive colapsado
        tras el botón "Rango personalizado" y se inserta con Insertar [Rango].
    -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Insertar fecha dinámica" FontSize="19" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Seleccione una opción y pulse Insertar. El marcador se sustituye por la fecha real al enviar el correo."/>

        <!-- Tokens simples: seleccionan, no insertan -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
            <Button x:Name="HoyBtn" Content="[Hoy]" Height="38" Margin="2" Tag="Hoy"
                    Style="{DynamicResource GhostButton}" Click="SimpleToken_Click"/>
            <Button x:Name="SemanaBtn" Content="[Semana]" Height="38" Margin="2" Tag="Semana"
                    Style="{DynamicResource GhostButton}" Click="SimpleToken_Click"/>
            <Button x:Name="MesBtn" Content="[Mes]" Height="38" Margin="2" Tag="Mes"
                    Style="{DynamicResource GhostButton}" Click="SimpleToken_Click"/>
            <Button x:Name="AnoBtn" Content="[Año]" Height="38" Margin="2" Tag="Año"
                    Style="{DynamicResource GhostButton}" Click="SimpleToken_Click"/>
        </UniformGrid>

        <!-- Al elegir [Semana] se despliega el día inicial (rango = una semana desde ese día) -->
        <Border Grid.Row="3" x:Name="SemanaPanel" Visibility="Collapsed"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Día que empieza la semana" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                <ComboBox x:Name="SemStartCombo" Height="30"/>
            </StackPanel>
        </Border>

        <!-- El rango vive tras un botón, no abierto por defecto -->
        <Button Grid.Row="4" x:Name="RangeToggleBtn" Content="⚙ Rango personalizado..."
                Style="{DynamicResource GhostButton}" Height="36" HorizontalAlignment="Stretch"
                Margin="0,0,0,8" Click="ToggleRange_Click"/>

        <Border Grid.Row="5" x:Name="RangeBorder" Visibility="Collapsed"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="RangeTitle" Text="Rango personalizado" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                <TextBlock Text="Modo de cálculo" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                <ComboBox x:Name="ModeCombo" Height="30" Margin="0,0,0,10" SelectionChanged="Config_Changed">
                    <ComboBoxItem Content="Entre dos días de la semana" Tag="Weekday"/>
                    <ComboBoxItem Content="Últimos N días (termina hoy)" Tag="Week"/>
                    <ComboBoxItem Content="Entre dos fechas fijas" Tag="Fixed"/>
                </ComboBox>

                <StackPanel x:Name="WeekPanel" Visibility="Collapsed">
                    <TextBlock Text="Cantidad de días" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                    <TextBox x:Name="DaysBox" Height="30" VerticalContentAlignment="Center"
                             Text="7" TextChanged="Config_Changed"/>
                </StackPanel>

                <StackPanel x:Name="FixedPanel" Visibility="Collapsed">
                    <TextBlock Text="Desde" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FromDateBox" Height="34" VerticalContentAlignment="Center" IsReadOnly="True" Padding="10,0"/>
                        <Button Grid.Column="1" Content="📅" Width="46" Height="34" Margin="6,0,0,0" FontSize="16"
                                VerticalContentAlignment="Center" Padding="0,2,0,4"
                                Style="{DynamicResource GhostButton}" ToolTip="Elegir fecha del calendario"
                                Click="PickFromDate_Click"/>
                    </Grid>
                    <TextBlock Text="Hasta" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ToDateBox" Height="34" VerticalContentAlignment="Center" IsReadOnly="True" Padding="10,0"/>
                        <Button Grid.Column="1" Content="📅" Width="46" Height="34" Margin="6,0,0,0" FontSize="16"
                                VerticalContentAlignment="Center" Padding="0,2,0,4"
                                Style="{DynamicResource GhostButton}" ToolTip="Elegir fecha del calendario"
                                Click="PickToDate_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="WeekdayPanel">
                    <TextBlock Text="Desde el día" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FromDayCombo" Height="30" Margin="0,0,0,8" SelectionChanged="Config_Changed"/>
                    <TextBlock Text="El rango abarca una semana desde ese día." FontSize="11"
                               Opacity="0.7" FontStyle="Italic"/>
                </StackPanel>

                <TextBlock Text="Formato de salida" FontSize="11" Opacity="0.7" Margin="0,10,0,4"/>
                <ComboBox x:Name="FormatCombo" Height="30" SelectionChanged="Config_Changed">
                    <ComboBoxItem Content="03/10/2026 al 09/10/2026" Tag="RangeWithAl"/>
                    <ComboBoxItem Content="03/10/2026 - 09/10/2026" Tag="RangeWithDash"/>
                    <ComboBoxItem Content="Solo la fecha final" Tag="EndOnly"/>
                    <ComboBoxItem Content="3 de octubre de 2026" Tag="EndLong"/>
                </ComboBox>

                <Border Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Vista previa" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                   Text="—"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="6" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancelar" Height="42" Margin="0,0,5,0" IsCancel="True"
                    Style="{DynamicResource DangerButton}"/>
            <Button Grid.Column="1" x:Name="InsertBtn" Content="Insertar" Height="42" Margin="5,0,0,0" IsDefault="True"
                    Style="{DynamicResource SuccessButton}" Click="InsertBtn_Click"/>
        </Grid>
    </Grid>
</Window>
