<Window x:Class="PautaDinamicaApp.Views.EmailDirectoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        Title="Directorio de Contactos" Height="650" Width="750"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}"/>
        <conv:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        <conv:BooleanToFontStyleConverter x:Key="BooleanToFontStyleConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Detección Automática de Destinatario" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Gestiona el mapeo de nombres detectados en la pauta hacia correos electrónicos." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Configuración de Detección -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Padding="15" CornerRadius="8" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Campo de Origen (Nombre/Agente):" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                <ComboBox ItemsSource="{Binding CurrentPautaFields}" 
                          SelectedValue="{Binding SelectedPauta.EmailNameFieldId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Label"
                          Height="36"/>
                <Button Content="🔍 Auto-detectar Agentes"
                        Command="{Binding AutoDetectAgentesCommand}"
                        Style="{StaticResource GhostButton}" Height="30" Margin="0,8,0,0" HorizontalAlignment="Left" FontSize="11"/>
                <TextBlock Text="* El sistema buscará el valor de este campo en el registro para encontrar el correo en el directorio." 
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Alerta de correos faltantes -->
        <Border Grid.Row="2" x:Name="MissingEmailAlert" Visibility="{Binding HasMissingEmails, Converter={StaticResource BoolToVis}}" 
                Background="#20EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12">
                    <Run FontWeight="Bold" Foreground="#EF4444">¡Atención!</Run>
                    <LineBreak/>
                    <Run Foreground="{DynamicResource TextBrush}">Hay agentes sin correo electrónico asociado. Complete los correos para poder enviarlos correctamente.</Run>
                </TextBlock>
                <Button Grid.Column="2" Content="🗂️ Directorio"
                        Command="{Binding OpenEmailDirectoryFromWarningCommand}"
                        Style="{StaticResource GhostButton}" Height="30" Padding="10,0" Margin="10,0,0,0" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Directorio -->
        <DockPanel Grid.Row="3">
            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}" Padding="10" CornerRadius="8,8,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0">
                <Grid>
                    <!-- Vista Normal -->
                    <WrapPanel Orientation="Horizontal" Visibility="{Binding IsContactMultiSelectMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <Button Content="➕ Nuevo" Command="{Binding AddContactCommand}" 
                                Style="{StaticResource PrimaryButton}" Padding="15,5" Height="34" Margin="0,0,8,8" FontSize="12"/>

                        <Button Content="☑️ Selección Múltiple" Command="{Binding ToggleContactMultiSelectCommand}" 
                                Style="{StaticResource GhostButton}"
                                Padding="15,5" Height="34" Margin="0,0,8,8" FontSize="12"/>
                        
                        <Button Content="📥 Importar" Command="{Binding ImportContactsCommand}" 
                                Style="{StaticResource GhostButton}" Padding="15,5" Height="34" Margin="0,0,8,8" FontSize="12"/>
                        
                        <Button Content="📤 Exportar" Command="{Binding ExportContactsCommand}" 
                                Style="{StaticResource SecondaryButton}"
                                Padding="15,5" Height="34" Margin="0,0,8,8" FontSize="12"/>
                    </WrapPanel>

                    <!-- Vista Selección Múltiple -->
                    <WrapPanel Orientation="Horizontal" Visibility="{Binding IsContactMultiSelectMode, Converter={StaticResource BoolToVis}}">
                        <CheckBox IsChecked="{Binding AllContactsSelected}" Content="Seleccionar Todo" 
                                  VerticalAlignment="Center" Margin="0,0,8,8">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="15,8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" SnapsToDevicePixels="True" Height="34">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="icon" Text="▢" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="14"/>
                                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="icon" Property="Text" Value="✅"/>
                                            <Setter TargetName="icon" Property="Foreground" Value="White"/>
                                            <Setter Property="TextElement.Foreground" Value="White" TargetName="border"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#3b82f6" Duration="0:0:0.1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <Button Content="📤 Exportar Seleccionados" Command="{Binding ExportContactsCommand}" 
                                Style="{StaticResource SecondaryButton}"
                                Padding="15,5" Height="34" Margin="0,0,8,8" FontSize="12"/>

                        <Button Content="🗑️ Eliminar Seleccionados" Command="{Binding DeleteSelectedContactsCommand}" 
                                Style="{StaticResource DangerButton}" Padding="15,5" Height="34" Margin="0,0,8,8" FontSize="12"/>
                        
                        <Button Content="❌ Cancelar Selección" Command="{Binding ToggleContactMultiSelectCommand}" 
                                Style="{StaticResource GhostButton}" Padding="15,5" Height="34" Margin="0,0,8,8" FontSize="12"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <DataGrid ItemsSource="{Binding CurrentContacts}" 
                      AutoGenerateColumns="False" 
                      Background="Transparent" 
                      BorderBrush="{DynamicResource BorderBrush}" 
                      BorderThickness="1,0,1,1"
                      CanUserAddRows="False" 
                      RowHeight="42" 
                      HeadersVisibility="Column" 
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource Self}, Path=Foreground}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMissingEmail}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#30EF4444"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <!-- Columna de Checkbox (Solo en modo Selección Múltiple) -->
                    <DataGridTemplateColumn Width="45" Visibility="{Binding Data.IsContactMultiSelectMode, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Nombre / Agente" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0" 
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                         Padding="10,0"
                                         Foreground="{Binding IsMissingEmail, Converter={StaticResource BooleanToColorConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Correo Electrónico" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0" 
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                         Padding="10,0" 
                                         Foreground="{Binding IsMissingEmail, Converter={StaticResource BooleanToColorConverter}}"
                                         FontStyle="{Binding IsMissingEmail, Converter={StaticResource BooleanToFontStyleConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Botón Eliminar Individual (Solo si NO estamos en Selección Múltiple) -->
                    <DataGridTemplateColumn Width="50" Visibility="{Binding Data.IsContactMultiSelectMode, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="×" Command="{Binding DataContext.DeleteContactCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" Foreground="{DynamicResource DangerBrush}" Background="Transparent" 
                                        FontSize="20" BorderThickness="0" Padding="0" VerticalAlignment="Center" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Pie -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="CANCELAR" Click="CancelButton_Click" 
                    Style="{StaticResource GhostButton}" Width="150" Height="45" Margin="0,0,10,0"/>
            
            <Button Content="APLICAR" Command="{Binding ApplyCommand}" 
                    Style="{StaticResource SecondaryButton}" Width="150" Height="45" Margin="0,0,10,0"/>

            <Button Content="ACEPTAR Y REGRESAR" Click="OkButton_Click" 
                    Style="{StaticResource SuccessButton}" Width="220" Height="45"/>
        </StackPanel>
    </Grid>
</Window>
