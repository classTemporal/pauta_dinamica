<Window x:Class="PautaDinamicaApp.Views.EmailDirectoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PautaDinamicaApp.Views.Converters"
        Title="Directorio de Contactos" Height="650" Width="750"
        WindowStartupLocation="CenterOwner" Background="#12151c" Foreground="#e1e1e1">
    
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Detección Automática de Destinatario" FontSize="22" FontWeight="Bold" Foreground="#10b981"/>
            <TextBlock Text="Gestiona el mapeo de nombres detectados en la pauta hacia correos electrónicos." FontSize="13" Foreground="#94a3b8" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Configuración de Detección -->
        <Border Grid.Row="1" Background="#1e222d" Padding="15" CornerRadius="8" Margin="0,0,0,15" BorderBrush="#3d4456" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Campo de Origen (Nombre/Agente):" FontWeight="Bold" Foreground="#e2e8f0" Margin="0,0,0,10"/>
                <ComboBox ItemsSource="{Binding CurrentPautaFields}" 
                          SelectedValue="{Binding SelectedPauta.EmailNameFieldId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Label"
                          Height="35" Background="#363d4d"/>
                <TextBlock Text="* El sistema buscará el valor de este campo en el registro para encontrar el correo en el directorio." 
                           FontSize="11" Foreground="#94a3b8" Margin="0,8,0,0" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Directorio -->
        <DockPanel Grid.Row="2">
            <Border DockPanel.Dock="Top" Background="#2d3446" Padding="10" CornerRadius="8,8,0,0" BorderBrush="#3d4456" BorderThickness="1,1,1,0">
                <Grid>
                    <!-- Vista Normal -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsContactMultiSelectMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <Button Content="➕ Nuevo" Command="{Binding AddContactCommand}" 
                                Padding="15,5" Height="32" Margin="0,0,8,0" FontSize="12"/>
                        
                        <Button Content="📥 Importar" Command="{Binding ImportContactsCommand}" 
                                Padding="15,5" Height="32" Margin="0,0,8,0" FontSize="12"/>
                        
                        <Button Content="📤 Exportar" Command="{Binding ExportContactsCommand}" 
                                Style="{StaticResource SecondaryButton}"
                                Padding="15,5" Height="32" Margin="0,0,8,0" FontSize="12"/>

                        <Button Content="☑️ Selección Múltiple" Command="{Binding ToggleContactMultiSelectCommand}" 
                                Style="{StaticResource GhostButton}"
                                Padding="15,5" Height="32" FontSize="12"/>
                    </StackPanel>

                    <!-- Vista Selección Múltiple -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsContactMultiSelectMode, Converter={StaticResource BoolToVis}}">
                        <CheckBox IsChecked="{Binding AllContactsSelected}" Content="Seleccionar Todo" 
                                  Foreground="#94a3b8" VerticalAlignment="Center" Margin="5,0,20,0"/>

                        <Button Content="📤 Exportar Seleccionados" Command="{Binding ExportContactsCommand}" 
                                Style="{StaticResource SecondaryButton}"
                                Padding="15,5" Height="32" Margin="0,0,8,0" FontSize="12"/>

                        <Button Content="🗑️ Eliminar Seleccionados" Command="{Binding DeleteSelectedContactsCommand}" 
                                Style="{StaticResource DangerButton}" Padding="15,5" Height="32" Margin="0,0,8,0" FontSize="12"/>
                        
                        <Button Content="❌ Cancelar Selección" Command="{Binding ToggleContactMultiSelectCommand}" 
                                Style="{StaticResource GhostButton}" Padding="15,5" Height="32" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid ItemsSource="{Binding CurrentContacts}" 
                      AutoGenerateColumns="False" 
                      Background="#1e222d" 
                      BorderBrush="#3d4456" 
                      BorderThickness="1"
                      CanUserAddRows="False"
                      RowHeight="40"
                      Foreground="White"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2d3446">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2d3446"/>
                        <Setter Property="Foreground" Value="#94a3b8"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="35"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2d3446"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <!-- Columna de Checkbox (Solo en modo Selección Múltiple) -->
                    <DataGridTemplateColumn Width="45" Visibility="{Binding Data.IsContactMultiSelectMode, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Nombre / Agente" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0" 
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                         Padding="10,0" Foreground="White"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Correo Electrónico" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0" 
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                         Padding="10,0" Foreground="#3b82f6"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Botón Eliminar Individual (Solo si NO estamos en Selección Múltiple) -->
                    <DataGridTemplateColumn Width="50" Visibility="{Binding Data.IsContactMultiSelectMode, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="×" Command="{Binding DataContext.DeleteContactCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" Foreground="#ef4444" Background="Transparent" 
                                        FontSize="18" BorderThickness="0" Padding="0" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Pie -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Content="CANCELAR CAMBIOS" Click="CancelButton_Click" 
                    Style="{StaticResource GhostButton}" Width="180" Height="45" Margin="0,0,15,0"/>
            
            <Button Grid.Column="1" Content="ACEPTAR Y REGRESAR" Click="OkButton_Click" 
                    Style="{StaticResource SuccessButton}" Width="220" Height="45"/>
        </Grid>
    </Grid>
</Window>

